---
import { getCollection } from "astro:content";
import RecipeCard from "@/components/cards/RecipeCard.astro";
import ToolCard from "@/components/cards/ToolCard.astro";
import CategoryBrowse from "@/components/home/CategoryBrowse.astro";
import EditorialPreview from "@/components/home/EditorialPreview.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import NewsletterCta from "@/components/home/NewsletterCta.astro";
import VideoGrid from "@/components/home/VideoGrid.astro";
import Section from "@/components/common/Section.astro";
import Footer from "@/components/navigation/Footer.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { homepageCuration } from "@/config/homepage";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRecipeSlug, getYouTubeThumbnailUrl } from "@/utils/recipe";

const [recipes, collections, series, tools] = await Promise.all([
  getCollection("recipes", ({ data }) => !data.draft),
  getCollection("collections"),
  getCollection("series"),
  getCollection("tools"),
]);

const recipesBySlug = new Map(recipes.map(recipe => [getRecipeSlug(recipe.id), recipe]));
const collectionsBySlug = new Map(collections.map(collection => [collection.data.slug, collection]));
const seriesBySlug = new Map<string, (typeof series)[number]>(series.map(entry => [entry.data.slug, entry]));
const toolsBySlug = new Map(tools.map(tool => [tool.data.slug, tool]));

const featuredRecipes = homepageCuration.featuredRecipes.flatMap(slug => {
  const recipe = recipesBySlug.get(slug);
  return recipe ? [recipe] : [];
});
const featuredCollections = homepageCuration.featuredCollections.flatMap(slug => {
  const collection = collectionsBySlug.get(slug);
  return collection ? [collection] : [];
});
const featuredSeries = homepageCuration.featuredSeries.flatMap(slug => {
  const entry = seriesBySlug.get(slug);
  return entry ? [entry] : [];
});
const featuredTools = homepageCuration.featuredTools.flatMap(slug => {
  const tool = toolsBySlug.get(slug);
  return tool ? [tool] : [];
});
const featuredVideos = homepageCuration.featuredVideos.flatMap(video => {
  const thumbnail = getYouTubeThumbnailUrl(video.url);
  return thumbnail ? [{ ...video, thumbnail }] : [];
});
const featuredRecipeSlugs = new Set(featuredRecipes.map(recipe => getRecipeSlug(recipe.id)));
const latestRecipes = recipes
  .filter(recipe => !featuredRecipeSlugs.has(getRecipeSlug(recipe.id)))
  .sort((left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime())
  .slice(0, 6);

const categoryDefinitions = [
  { title: "By Protein", description: "Find recipes by your main ingredient.", isRepresented: recipes.some(recipe => recipe.data.protein.length > 0) },
  { title: "By Meal", description: "Browse ideas for lunch, dinner, snacks, and desserts.", isRepresented: recipes.some(recipe => recipe.data.meal.length > 0) },
  { title: "By Cuisine", description: "Explore Bengali cooking and more comfort-food traditions.", isRepresented: recipes.some(recipe => Boolean(recipe.data.cuisine)) },
  { title: "By Type", description: "Discover curries, sweets, rice dishes, and more.", isRepresented: recipes.some(recipe => recipe.data.type.length > 0) },
];
const categories = categoryDefinitions.filter(category => category.isRepresented);

const existingInternalRoutes = new Set(["/", "/about", "/work-with-us", "/search"]);
const navigationItems = siteConfig.navigation.filter(item => existingInternalRoutes.has(item.href));
const footerGroups = siteConfig.footerNavigation
  .map(group => ({ ...group, items: group.items.filter(item => existingInternalRoutes.has(item.href)) }))
  .filter(group => group.items.length > 0);
---

<BaseLayout metadata={{ description: siteConfig.description, canonicalPath: "/" }}>
  <Navbar brand={{ label: siteConfig.name, href: "/" }} items={navigationItems} />
  <main id="main-content">
    <HomeHero image={featuredRecipes[0]?.data.coverImage} imageAlt={featuredRecipes[0]?.data.coverImageAlt} />

    {featuredRecipes.length > 0 && (
      <Section id="featured-recipes" width="wide" spacing="lg">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-bold tracking-[0.12em] text-accent uppercase">Start here</p>
            <h2 class="mt-2 font-display text-4xl font-semibold tracking-tight text-foreground">Featured recipes</h2>
          </div>
          <p class="max-w-xl leading-relaxed text-muted-foreground">Six Calcutta Kitchen favourites chosen for dependable home cooking.</p>
        </div>
        <div class="mt-8 grid gap-6 tablet:grid-cols-2 desktop:grid-cols-3">
          {featuredRecipes.map(recipe => (
            <RecipeCard
              href={`/recipes/${getRecipeSlug(recipe.id)}/`}
              title={recipe.data.title}
              description={recipe.data.description}
              image={recipe.data.coverImage}
              imageAlt={recipe.data.coverImageAlt}
              eyebrow={recipe.data.cuisine}
              metadata={[`${recipe.data.cookTime} min cook`, recipe.data.difficulty]}
            />
          ))}
        </div>
      </Section>
    )}

    {categories.length > 0 && (
      <Section width="wide" tone="surface" spacing="lg">
        <CategoryBrowse {categories} />
      </Section>
    )}

    {featuredCollections.length > 0 && (
      <Section width="wide" spacing="lg">
        <div class="space-y-6">
          <p class="text-sm font-bold tracking-[0.12em] text-accent uppercase">Curated for you</p>
          {featuredCollections.map(collection => (
            <EditorialPreview
              eyebrow="Featured collection"
              title={collection.data.title}
              description={collection.data.description}
              image={collection.data.coverImage}
              imageAlt={collection.data.coverImageAlt}
            />
          ))}
        </div>
      </Section>
    )}

    {featuredSeries.length > 0 && (
      <Section width="wide" tone="surface" spacing="lg">
        <div class="space-y-6">
          <p class="text-sm font-bold tracking-[0.12em] text-accent uppercase">Signature series</p>
          {featuredSeries.map(entry => (
            <EditorialPreview
              eyebrow="Cook Like a Lyadhkhor"
              title={entry.data.title}
              description={entry.data.description}
              image={entry.data.coverImage}
              imageAlt={entry.data.coverImageAlt}
            />
          ))}
        </div>
      </Section>
    )}

    {featuredTools.length > 0 && (
      <Section width="wide" spacing="lg">
        <h2 class="font-display text-4xl font-semibold tracking-tight text-foreground">Tools we use</h2>
        <div class="mt-8 grid gap-6 tablet:grid-cols-2 desktop:grid-cols-3">
          {featuredTools.map(tool => (
            <ToolCard
              href={tool.data.affiliateLink ?? "/kitchen-tools/"}
              title={tool.data.title}
              description={tool.data.description}
              image={tool.data.image}
              imageAlt={tool.data.imageAlt}
              external={Boolean(tool.data.affiliateLink)}
            />
          ))}
        </div>
      </Section>
    )}

    {latestRecipes.length > 0 && (
      <Section width="wide" spacing="lg">
        <h2 class="font-display text-4xl font-semibold tracking-tight text-foreground">Latest recipes</h2>
        <div class="mt-8 grid gap-6 tablet:grid-cols-2 desktop:grid-cols-3">
          {latestRecipes.map(recipe => (
            <RecipeCard
              href={`/recipes/${getRecipeSlug(recipe.id)}/`}
              title={recipe.data.title}
              description={recipe.data.description}
              image={recipe.data.coverImage}
              imageAlt={recipe.data.coverImageAlt}
              eyebrow={recipe.data.cuisine}
              metadata={[`${recipe.data.cookTime} min cook`, recipe.data.difficulty]}
            />
          ))}
        </div>
      </Section>
    )}

    {featuredVideos.length > 0 && (
      <Section width="wide" tone="surface" spacing="lg">
        <VideoGrid videos={featuredVideos} />
      </Section>
    )}

    <Section width="wide" spacing="lg">
      <NewsletterCta />
    </Section>
  </main>
  <Footer brand={{ label: siteConfig.name, href: "/" }} groups={footerGroups} socialLinks={siteConfig.socialLinks} />
</BaseLayout>
