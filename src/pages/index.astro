---
import { getCollection } from "astro:content";
import RecipeCard from "@/components/cards/RecipeCard.astro";
import ToolCard from "@/components/cards/ToolCard.astro";
import EditorialPreview from "@/components/home/EditorialPreview.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import InstagramGrid from "@/components/home/InstagramGrid.astro";
import KitchenToolsPromo from "@/components/home/KitchenToolsPromo.astro";
import NewsletterCta from "@/components/home/NewsletterCta.astro";
import RecipeDiscoveryStrip from "@/components/home/RecipeDiscoveryStrip.astro";
import VideoGrid from "@/components/home/VideoGrid.astro";
import Section from "@/components/common/Section.astro";
import Footer from "@/components/navigation/Footer.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { homepageDiscoveryCategories } from "@/config/categories";
import { homepageCuration } from "@/config/homepage";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRecipeSlug, getYouTubeThumbnailUrl } from "@/utils/recipe";

const [recipes, collections, series, tools] = await Promise.all([
  getCollection("recipes", ({ data }) => !data.draft),
  getCollection("collections"),
  getCollection("series"),
  getCollection("tools"),
]);

const recipesBySlug = new Map(
  recipes.map(recipe => [getRecipeSlug(recipe.id), recipe])
);
const collectionsBySlug = new Map(
  collections.map(collection => [collection.data.slug, collection])
);
const seriesBySlug = new Map<string, (typeof series)[number]>(
  series.map(entry => [entry.data.slug, entry])
);
const toolsBySlug = new Map(tools.map(tool => [tool.data.slug, tool]));

const featuredRecipes = homepageCuration.featuredRecipes.flatMap(slug => {
  const recipe = recipesBySlug.get(slug);
  return recipe ? [recipe] : [];
});
const featuredCollections = homepageCuration.featuredCollections.flatMap(
  slug => {
    const collection = collectionsBySlug.get(slug);
    return collection ? [collection] : [];
  }
);
const featuredSeries = homepageCuration.featuredSeries.flatMap(slug => {
  const entry = seriesBySlug.get(slug);
  return entry ? [entry] : [];
});
const featuredTools = homepageCuration.featuredTools.flatMap(slug => {
  const tool = toolsBySlug.get(slug);
  return tool ? [tool] : [];
});
const featuredVideos = homepageCuration.featuredVideos.flatMap(video => {
  const thumbnail = getYouTubeThumbnailUrl(video.url);
  return thumbnail ? [{ ...video, thumbnail }] : [];
});
const featuredRecipeSlugs = new Set(
  featuredRecipes.map(recipe => getRecipeSlug(recipe.id))
);
const latestRecipes = recipes
  .filter(recipe => !featuredRecipeSlugs.has(getRecipeSlug(recipe.id)))
  .sort(
    (left, right) =>
      right.data.publishDate.getTime() - left.data.publishDate.getTime()
  )
  .slice(0, 6);

const discoveryItems = homepageDiscoveryCategories.map(category => ({
  label: category.label,
  href: `/categories/${category.slug}/`,
  icon: category.icon,
}));
const youtubeHref = siteConfig.socialLinks.find(
  link => link.platform === "youtube"
)?.href;
const instagramHref = siteConfig.socialLinks.find(
  link => link.platform === "instagram"
)?.href;
---

<BaseLayout
  metadata={{ description: siteConfig.description, canonicalPath: "/" }}
>
  <Navbar
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    items={siteConfig.navigation}
    socialLinks={siteConfig.socialLinks}
  />
  <main id="main-content">
    <HomeHero
      image={featuredRecipes[0]?.data.coverImage}
      imageAlt={featuredRecipes[0]?.data.coverImageAlt}
      {youtubeHref}
      {instagramHref}
    />
    <RecipeDiscoveryStrip items={discoveryItems} />
    <KitchenToolsPromo href="/kitchen-tools/" />

    {
      featuredRecipes.length > 0 && (
        <Section id="featured-recipes" width="wide" spacing="sm">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="font-display text-foreground tablet:text-4xl text-3xl font-medium tracking-tight">
              Featured recipes
            </h2>
          </div>
          <div class="tablet:mx-0 tablet:grid tablet:gap-6 tablet:overflow-visible tablet:px-0 tablet:pb-0 tablet:grid-cols-2 desktop:grid-cols-3 -mx-4 mt-6 flex snap-x snap-mandatory [scrollbar-width:none] gap-4 overflow-x-auto px-4 pb-2 [&::-webkit-scrollbar]:hidden">
            {featuredRecipes.map(recipe => (
              <RecipeCard
                href={`/recipes/${getRecipeSlug(recipe.id)}/`}
                title={recipe.data.title}
                description={recipe.data.description}
                image={recipe.data.coverImage}
                imageAlt={recipe.data.coverImageAlt}
                eyebrow={recipe.data.cuisine}
                metadata={[
                  `${recipe.data.cookTime} min cook`,
                  recipe.data.difficulty,
                ]}
                class="tablet:w-auto w-[82vw] shrink-0 snap-start"
              />
            ))}
          </div>
        </Section>
      )
    }

    {
      (featuredCollections.length > 0 || featuredSeries.length > 0) && (
        <Section width="wide" spacing="sm">
          <section aria-labelledby="explore-calcutta-kitchen-heading">
            <p class="text-accent text-sm font-normal tracking-[0.12em] uppercase">
              Curated for you
            </p>
            <h2
              id="explore-calcutta-kitchen-heading"
              class="font-display text-foreground tablet:text-4xl mt-2 text-3xl font-medium tracking-tight"
            >
              Explore Calcutta Kitchen
            </h2>
            <div class="tablet:mx-0 tablet:grid tablet:overflow-visible tablet:px-0 tablet:pb-0 tablet:grid-cols-2 -mx-4 mt-6 flex snap-x snap-mandatory [scrollbar-width:none] gap-4 overflow-x-auto px-4 pb-2 [&::-webkit-scrollbar]:hidden">
              {featuredCollections.map(collection => (
                <EditorialPreview
                  eyebrow="Featured collection"
                  title={collection.data.title}
                  description={collection.data.description}
                  image={collection.data.coverImage}
                  imageAlt={collection.data.coverImageAlt}
                  class="tablet:w-auto w-[84vw] shrink-0 snap-start"
                />
              ))}
              {featuredSeries.map(entry => (
                <EditorialPreview
                  eyebrow="Signature series"
                  title={entry.data.title}
                  description={entry.data.description}
                  image={entry.data.coverImage}
                  imageAlt={entry.data.coverImageAlt}
                  class="tablet:w-auto w-[84vw] shrink-0 snap-start"
                />
              ))}
            </div>
          </section>
        </Section>
      )
    }

    {
      featuredTools.length > 0 && (
        <Section width="wide" spacing="md" class="tablet:py-16 py-10">
          <h2 class="font-display text-foreground text-4xl font-semibold tracking-tight">
            Tools we use
          </h2>
          <div class="tablet:grid-cols-2 desktop:grid-cols-3 mt-8 grid gap-6">
            {featuredTools.map(tool => (
              <ToolCard
                href={tool.data.affiliateLink ?? "/kitchen-tools/"}
                title={tool.data.title}
                description={tool.data.description}
                image={tool.data.image}
                imageAlt={tool.data.imageAlt}
                external={Boolean(tool.data.affiliateLink)}
              />
            ))}
          </div>
        </Section>
      )
    }

    {
      latestRecipes.length > 0 && (
        <Section width="wide" spacing="lg">
          <h2 class="font-display text-foreground tablet:text-4xl text-3xl font-medium tracking-tight">
            Latest recipes
          </h2>
          <div class="tablet:grid-cols-2 desktop:grid-cols-3 mt-8 grid gap-6">
            {latestRecipes.map(recipe => (
              <RecipeCard
                href={`/recipes/${getRecipeSlug(recipe.id)}/`}
                title={recipe.data.title}
                description={recipe.data.description}
                image={recipe.data.coverImage}
                imageAlt={recipe.data.coverImageAlt}
                eyebrow={recipe.data.cuisine}
                metadata={[
                  `${recipe.data.cookTime} min cook`,
                  recipe.data.difficulty,
                ]}
              />
            ))}
          </div>
        </Section>
      )
    }

    {
      featuredVideos.length > 0 && (
        <Section
          width="wide"
          tone="surface"
          spacing="md"
          class="tablet:py-16 py-10"
        >
          <VideoGrid videos={featuredVideos} />
        </Section>
      )
    }

    {
      homepageCuration.featuredInstagram.length > 0 && (
        <Section
          width="wide"
          tone="surface"
          spacing="md"
          class="tablet:py-16 py-10"
        >
          <InstagramGrid posts={homepageCuration.featuredInstagram} />
        </Section>
      )
    }

    <Section width="wide" spacing="sm" class="!pt-0">
      <NewsletterCta />
    </Section>
  </main>
  <Footer
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    groups={siteConfig.footerNavigation}
    socialLinks={siteConfig.socialLinks}
  />
</BaseLayout>
