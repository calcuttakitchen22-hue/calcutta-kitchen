---
import { getCollection, type CollectionEntry } from "astro:content";
import { products } from "@/data/products";
import RecipeLayout from "@/layouts/RecipeLayout.astro";
import { getRecipeSlug, getRelatedRecipes } from "@/utils/recipe";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes", ({ data }) => !data.draft);

  return recipes.map(recipe => ({
    params: { slug: getRecipeSlug(recipe.id) },
    props: { recipe },
  }));
}

type Props = {
  recipe: CollectionEntry<"recipes">;
};

const { recipe } = Astro.props;
const slug = getRecipeSlug(recipe.id);
const recipes = await getCollection("recipes", ({ data }) => !data.draft);
const productsById = new Map(products.map(product => [product.id, product]));
const recipeProducts = recipe.data.affiliateProducts.flatMap(id => {
  const product = productsById.get(id);
  return product ? [product] : [];
});
const relatedRecipes = getRelatedRecipes(recipe, recipes).map(entry => ({
  href: `/recipes/${getRecipeSlug(entry.id)}/`,
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.coverImage,
  imageAlt: entry.data.coverImageAlt,
  eyebrow: entry.data.cuisine,
  metadata: [`${entry.data.cookTime} min cook`, entry.data.difficulty],
}));
---

<RecipeLayout recipe={recipe.data} {slug} products={recipeProducts} {relatedRecipes} />
