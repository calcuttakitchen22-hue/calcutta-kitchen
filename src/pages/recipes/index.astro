---
import { getCollection } from "astro:content";
import RecipeCard from "@/components/cards/RecipeCard.astro";
import Section from "@/components/common/Section.astro";
import Footer from "@/components/navigation/Footer.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRecipeSlug } from "@/utils/recipe";

const recipes = (
  await getCollection("recipes", ({ data }) => !data.draft)
).sort(
  (left, right) =>
    right.data.publishDate.getTime() - left.data.publishDate.getTime()
);
---

<BaseLayout
  metadata={{
    title: "Recipes",
    description: "Browse Calcutta Kitchen recipes for confident home cooking.",
    canonicalPath: "/recipes/",
  }}
>
  <Navbar
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    items={siteConfig.navigation}
    socialLinks={siteConfig.socialLinks}
  />
  <main id="main-content">
    <Section width="wide" spacing="md">
      <p class="text-accent text-sm font-normal tracking-[0.12em] uppercase">
        Recipe library
      </p>
      <h1
        class="font-display text-foreground tablet:text-6xl mt-2 text-5xl font-semibold tracking-tight"
      >
        Recipes
      </h1>
      <p class="text-muted-foreground mt-5 max-w-2xl text-lg leading-relaxed">
        Reliable recipes for everyday Bengali cooking and modern comfort food.
      </p>
      {
        recipes.length > 0 && (
          <div class="tablet:grid-cols-2 desktop:grid-cols-3 mt-10 grid gap-6">
            {recipes.map(recipe => (
              <RecipeCard
                href={`/recipes/${getRecipeSlug(recipe.id)}/`}
                title={recipe.data.title}
                description={recipe.data.description}
                image={recipe.data.coverImage}
                imageAlt={recipe.data.coverImageAlt}
                eyebrow={recipe.data.cuisine}
                metadata={[
                  `${recipe.data.cookTime} min cook`,
                  recipe.data.difficulty,
                ]}
              />
            ))}
          </div>
        )
      }
    </Section>
  </main>
  <Footer
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    groups={siteConfig.footerNavigation}
    socialLinks={siteConfig.socialLinks}
  />
</BaseLayout>
