---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/common/Button.astro";
import Container from "@/components/common/Container.astro";
import Heading from "@/components/common/Heading.astro";
import Section from "@/components/common/Section.astro";
import Footer from "@/components/navigation/Footer.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { siteConfig } from "@/config/site";

const collaborationBenefits = [
  {
    title: "Authentic storytelling",
    description:
      "Food-first stories that bring a product naturally into the cooking conversation.",
  },
  {
    title: "Recipe-led content",
    description:
      "Practical recipes that give audiences a clear reason to save, watch, and cook.",
  },
  {
    title: "A distinctive point of view",
    description:
      "A recognisable narration style shaped around approachable home cooking.",
  },
  {
    title: "Cooking across cultures",
    description:
      "Content spanning traditional Bengali recipes, global cuisine, and fusion dishes.",
  },
];

const audienceStats = [
  { value: "395K+", label: "Combined audience" },
  { value: "95K+", label: "Instagram" },
  { value: "50K+", label: "YouTube" },
  { value: "250K+", label: "Facebook" },
  { value: "20+", label: "Brand collaborations" },
];

const services = [
  {
    title: "Sponsored Reels",
    description: "Authentic brand integrations within recipe-driven content.",
  },
  {
    title: "Dedicated Recipe Videos",
    description: "Custom recipes developed around your product.",
  },
  {
    title: "YouTube Integrations",
    description: "Native placements within long-form cooking content.",
  },
  {
    title: "UGC Content",
    description: "Creator-style content for brand-owned channels.",
  },
  {
    title: "Recipe Development",
    description:
      "Original recipes designed around campaigns and product launches.",
  },
  {
    title: "Food Photography",
    description: "Commercial-quality food photography for social and digital.",
  },
  {
    title: "Product Reviews",
    description: "Creator-led product demonstrations and reviews.",
  },
];

const brands = [
  {
    name: "Doctor's Choice",
    logo: "doctors-choice.jfif",
    link: "https://www.instagram.com/reel/DY4cEKMIjKt/",
  },
  {
    name: "Atomberg",
    logo: "atomberg.png",
    link: "https://www.instagram.com/reel/DXWpWPWDwtE/",
  },
  {
    name: "Bagicha",
    logo: "bagicha.jfif",
    link: "https://www.instagram.com/reel/DXHK5Brj9T7/",
  },
  {
    name: "AGARO",
    logo: "agaro.webp",
    link: "https://www.instagram.com/reel/DWoa6sECLo7/",
  },
  {
    name: "Everest",
    logo: "everest.png",
    link: "https://www.instagram.com/reel/DWOoxl7iB0d/",
  },
  {
    name: "Country Delight",
    logo: "country-delight.png",
    link: "https://www.instagram.com/reel/DVLltHTE60D/",
  },
  {
    name: "Blacksmith",
    logo: "blacksmith.png",
    link: "https://www.instagram.com/reel/DUae2YiiBVF/",
  },
  {
    name: "Licious",
    logo: "licious.png",
    link: "https://www.instagram.com/reel/DSc3HiZklgp/",
  },
  {
    name: "Jolkhabar",
    logo: "jolkhabar.jpg",
    link: "https://www.instagram.com/reel/DSKtbnxCH_Z/",
  },
];

const collaborationProcess = [
  "Brief & alignment",
  "Creative direction",
  "Production",
  "Review & delivery",
];

const faqs = [
  {
    question: "What can we collaborate on?",
    answer:
      "Calcutta Kitchen works on sponsored reels, dedicated recipe videos, YouTube integrations, UGC content, recipe development, food photography, and product reviews.",
  },
  {
    question: "Can we see previous brand collaborations?",
    answer:
      "Yes. The campaign selection above links to previous collaboration reels on Instagram.",
  },
  {
    question: "How do we get in touch?",
    answer:
      "Email calcuttakitchen22@gmail.com or chat on WhatsApp at +91 7063640680.",
  },
];
---

<BaseLayout
  metadata={{
    title: "Work With Us",
    description:
      "Partner with Calcutta Kitchen for recipe development, food storytelling, sponsored content, and brand collaborations.",
    canonicalPath: "/work-with-us/",
  }}
>
  <Navbar
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    items={siteConfig.navigation}
    socialLinks={siteConfig.socialLinks}
  />

  <main id="main-content">
    <Section
      spacing="sm"
      class="tablet:py-12 desktop:py-16 overflow-hidden py-10"
    >
      <div
        class="tablet:gap-8 desktop:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] desktop:gap-12 grid items-center gap-6"
      >
        <div class="max-w-2xl">
          <p
            class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
          >
            Brand collaborations
          </p>
          <Heading
            level={1}
            weight="normal"
            class="tablet:text-5xl desktop:text-6xl text-4xl"
          >
            Work With Calcutta Kitchen
          </Heading>
          <p
            class="text-muted-foreground tablet:mt-5 tablet:text-lg mt-4 max-w-xl leading-7"
          >
            Recipe-led storytelling for brands that want to become part of the
            everyday cooking conversation.
          </p>
          <div class="tablet:mt-6 mt-5 flex flex-wrap gap-3">
            <span
              class="rounded-pill border-border text-muted-foreground inline-flex min-h-11 items-center justify-center border px-5 text-base font-normal max-sm:w-full"
              aria-label="Media kit coming soon"
            >
              Download Media Kit — coming soon
            </span>
            <Button href="#contact" variant="secondary" class="max-sm:w-full"
              >Start a Collaboration</Button
            >
            <Button href="#campaigns" variant="primary" class="max-sm:w-full"
              >View Brand Collaborations</Button
            >
          </div>
        </div>

        <figure class="bg-surface shadow-card overflow-hidden rounded-lg">
          <img
            src="/media-kit/creator-pic.JPG"
            alt="The creator behind Calcutta Kitchen"
            width="1200"
            height="900"
            loading="eager"
            class="aspect-[4/3] h-full w-full object-cover"
          />
        </figure>
      </div>
    </Section>

    <Section
      spacing="sm"
      tone="surface"
      class="tablet:py-10 desktop:py-12 py-8"
    >
      <div
        class="tablet:gap-8 desktop:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] desktop:gap-12 grid gap-6"
      >
        <div>
          <p
            class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
          >
            The Calcutta Kitchen approach
          </p>
          <Heading level={2} weight="normal" class="tablet:text-4xl text-3xl"
            >Why brands work with us</Heading
          >
          <p class="text-muted-foreground mt-4 max-w-xl leading-7">
            Since 2022, Calcutta Kitchen has built a food-loving community
            through approachable recipes, engaging food stories, and creator-led
            collaborations.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {
            collaborationBenefits.map(benefit => (
              <article class="border-border bg-background tablet:p-5 rounded-md border p-4">
                <h3 class="font-display text-foreground tablet:text-xl text-lg leading-snug font-normal">
                  {benefit.title}
                </h3>
                <p class="text-muted-foreground mt-2 leading-6">
                  {benefit.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </Section>

    <Section spacing="sm" class="tablet:py-10 desktop:py-12 py-8">
      <div
        class="tablet:flex-row tablet:items-end tablet:justify-between flex flex-col gap-4"
      >
        <div>
          <p
            class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
          >
            Audience snapshot
          </p>
          <Heading level={2} weight="normal" class="tablet:text-4xl text-3xl"
            >A growing food community</Heading
          >
        </div>
        <p class="text-muted-foreground max-w-md leading-7">
          A community built around authentic recipes and practical cooking
          inspiration.
        </p>
      </div>
      <dl class="desktop:grid-cols-5 tablet:mt-6 mt-5 grid grid-cols-2 gap-3">
        {
          audienceStats.map(stat => (
            <div class="border-border bg-surface tablet:p-5 rounded-md border p-4">
              <dt class="text-muted-foreground text-sm leading-6">
                {stat.label}
              </dt>
              <dd class="font-display text-accent mt-2 text-2xl leading-none font-normal">
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <Section
      spacing="sm"
      tone="surface"
      class="tablet:py-10 desktop:py-12 py-8"
    >
      <div class="max-w-2xl">
        <p
          class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
        >
          Ways to work together
        </p>
        <Heading level={2} weight="normal" class="tablet:text-4xl text-3xl"
          >Collaboration opportunities</Heading
        >
      </div>
      <div
        class="tablet:grid-cols-2 desktop:grid-cols-3 tablet:mt-6 mt-5 grid grid-cols-2 gap-3"
      >
        {
          services.map(service => (
            <article class="border-border bg-background tablet:p-5 rounded-md border p-4">
              <h3 class="font-display text-foreground tablet:text-xl text-lg leading-snug font-normal">
                {service.title}
              </h3>
              <p class="text-muted-foreground mt-2 leading-6">
                {service.description}
              </p>
            </article>
          ))
        }
      </div>
    </Section>

    <Section
      spacing="sm"
      id="campaigns"
      class="tablet:py-10 desktop:py-12 py-8"
    >
      <div class="max-w-2xl">
        <p
          class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
        >
          Previous collaborations
        </p>
        <Heading level={2} weight="normal" class="tablet:text-4xl text-3xl"
          >Brands we have worked with</Heading
        >
        <p class="text-muted-foreground mt-4 leading-7">
          A selection of recent brand collaborations. Each card opens the
          published campaign on Instagram.
        </p>
      </div>
      <ul class="tablet:grid-cols-3 tablet:mt-6 mt-5 grid grid-cols-2 gap-3">
        {
          brands.map(brand => (
            <li>
              <a
                href={brand.link}
                target="_blank"
                rel="noreferrer"
                class="focus-visible:outline-focus border-border bg-surface tablet:min-h-28 tablet:p-5 hover:border-accent flex min-h-24 items-center justify-center rounded-md border p-4 transition focus-visible:outline-2 focus-visible:outline-offset-2"
                aria-label={`View ${brand.name} collaboration on Instagram`}
              >
                <img
                  src={`/media-kit/${brand.logo}`}
                  alt={brand.name}
                  width="240"
                  height="100"
                  loading="lazy"
                  class="tablet:max-h-14 max-h-12 w-auto max-w-full object-contain"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section
      spacing="sm"
      tone="surface"
      class="tablet:py-10 desktop:py-12 py-8"
    >
      <div
        class="tablet:gap-8 desktop:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] desktop:gap-12 grid gap-6"
      >
        <div>
          <p
            class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
          >
            Content principles
          </p>
          <Heading level={2} weight="normal" class="tablet:text-4xl text-3xl"
            >Why our content performs</Heading
          >
          <p class="text-muted-foreground mt-4 max-w-xl leading-7">
            Educational storytelling, visually appetising food, practical
            recipes, and an authentic creator voice give every collaboration a
            clear place in the everyday cooking conversation.
          </p>
        </div>
        <div class="grid grid-cols-3 gap-3">
          {
            ["Recipe videos", "Creator stories", "Food photography"].map(
              format => (
                <article class="border-border bg-background tablet:aspect-[4/5] tablet:p-5 flex aspect-[4/3] items-end rounded-md border p-3">
                  <h3 class="font-display text-foreground tablet:text-xl text-base leading-snug font-normal">
                    {format}
                  </h3>
                </article>
              )
            )
          }
        </div>
      </div>
    </Section>

    <Section spacing="sm" class="tablet:py-10 desktop:py-12 py-8">
      <div
        class="tablet:gap-8 desktop:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] desktop:gap-12 grid gap-6"
      >
        <div>
          <p
            class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
          >
            From first brief to final delivery
          </p>
          <Heading level={2} weight="normal" class="tablet:text-4xl text-3xl"
            >A clear collaboration process</Heading
          >
        </div>
        <ol class="grid grid-cols-2 gap-3">
          {
            collaborationProcess.map((step, index) => (
              <li class="border-border bg-surface tablet:p-5 flex gap-3 rounded-md border p-4">
                <span class="font-display text-accent text-xl leading-none font-normal">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="text-foreground pt-0.5 leading-6">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </Section>

    <Section
      spacing="sm"
      tone="surface"
      class="tablet:py-10 desktop:py-12 py-8"
    >
      <div class="mx-auto max-w-3xl">
        <p
          class="text-accent mb-3 text-center text-sm font-normal tracking-[0.12em] uppercase"
        >
          Common questions
        </p>
        <Heading
          level={2}
          align="center"
          weight="normal"
          class="tablet:text-4xl text-3xl">FAQ</Heading
        >
        <div
          class="divide-border border-border tablet:mt-6 mt-5 divide-y border-y"
        >
          {
            faqs.map(faq => (
              <details class="group tablet:py-5 py-4">
                <summary class="text-foreground focus-visible:outline-focus flex cursor-pointer list-none items-center justify-between gap-4 leading-6 focus-visible:outline-2 focus-visible:outline-offset-4">
                  <span>{faq.question}</span>
                  <span
                    aria-hidden="true"
                    class="text-accent transition group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="text-muted-foreground mt-2 max-w-2xl leading-6">
                  {faq.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </Section>

    <Section
      id="contact"
      spacing="sm"
      class="tablet:py-12 desktop:py-16 py-10 text-center"
    >
      <Container size="content" class="max-w-3xl px-0">
        <p
          class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
        >
          Start a conversation
        </p>
        <Heading
          level={2}
          align="center"
          weight="normal"
          class="tablet:text-4xl text-3xl"
        >
          Let&apos;s build something meaningful together.
        </Heading>
        <p class="text-muted-foreground mx-auto mt-4 max-w-2xl leading-7">
          Looking for recipe content, product integrations, food photography, or
          creator-led campaigns? We would love to hear about your idea.
        </p>
        <div class="tablet:mt-6 mt-5 flex flex-wrap justify-center gap-3">
          <Button
            href="mailto:calcuttakitchen22@gmail.com"
            class="max-sm:w-full">Email Us</Button
          >
          <span
            class="rounded-pill border-border text-muted-foreground inline-flex min-h-11 items-center justify-center border px-5 text-base font-normal max-sm:w-full"
            aria-label="Media kit coming soon"
          >
            Download Media Kit — coming soon
          </span>
        </div>
        <div
          class="text-muted-foreground tablet:mt-6 mt-5 space-y-1 text-sm leading-6"
        >
          <p>calcuttakitchen22@gmail.com · +91 7063640680</p>
          <p>calcuttakitchen.in · @calcuttakitchen.in</p>
        </div>
      </Container>
    </Section>
  </main>

  <Footer
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    groups={siteConfig.footerNavigation}
    socialLinks={siteConfig.socialLinks}
  />
</BaseLayout>
