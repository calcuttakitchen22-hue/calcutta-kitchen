---
import ProductCard from "@/components/ProductCard.astro";
import Button from "@/components/common/Button.astro";
import Heading from "@/components/common/Heading.astro";
import SearchInput from "@/components/common/SearchInput.astro";
import Section from "@/components/common/Section.astro";
import Footer from "@/components/navigation/Footer.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { siteConfig } from "@/config/site";
import { products } from "@/data/products";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Product = (typeof products)[number];

const grouped: Record<string, Product[]> = {};

products
  .slice()
  .sort((left, right) => left.displayOrder - right.displayOrder)
  .forEach(product => {
    (grouped[product.category] ??= []).push(product);
  });

const categories = Object.keys(grouped);
---

<BaseLayout
  metadata={{
    title: "Kitchen Tools We Trust",
    description:
      "Explore the cookware, utensils, knives and kitchen gadgets that we personally use and recommend.",
    canonicalPath: "/kitchen-tools/",
  }}
>
  <Navbar
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    items={siteConfig.navigation}
    socialLinks={siteConfig.socialLinks}
  />

  <main id="main-content">
    <Section width="wide" spacing="sm" class="tablet:py-12 desktop:py-16 py-10">
      <div class="max-w-3xl">
        <p
          class="text-accent mb-3 text-sm font-normal tracking-[0.12em] uppercase"
        >
          Tools we use
        </p>
        <Heading
          level={1}
          weight="normal"
          class="tablet:text-5xl desktop:text-6xl text-4xl"
        >
          Kitchen Tools We Trust
        </Heading>
        <div
          class="text-muted-foreground tablet:mt-5 mt-4 max-w-xl space-y-3 leading-7"
        >
          <p>
            Every recipe on Calcutta Kitchen is tested in our own home kitchen.
            Over the years we&apos;ve found ourselves reaching for the same
            trusted cookware, utensils and appliances again and again.
          </p>
          <p>
            If you&apos;re building your kitchen or simply looking to upgrade a
            few essentials, these are the products we genuinely recommend.
          </p>
        </div>
        <form
          id="tools-search-form"
          class="tablet:mt-6 mt-5 flex gap-3"
          role="search"
        >
          <SearchInput
            id="tools-search"
            label="Search kitchen tools"
            placeholder="Search tools..."
            class="min-w-0 flex-1"
          />
          <Button class="tablet:px-5 tablet:text-base shrink-0 px-3 text-xs">
            Search Tools
          </Button>
        </form>
      </div>
    </Section>

    <section
      aria-label="Tool categories"
      class="border-border bg-background/95 sticky top-[72px] z-30 border-y backdrop-blur"
    >
      <div
        class="tablet:px-6 desktop:px-8 max-w-wide mx-auto w-full [scrollbar-width:none] overflow-x-auto px-4 py-3 [&::-webkit-scrollbar]:hidden"
      >
        <ul class="tablet:w-auto tablet:flex-wrap flex w-max gap-2">
          {
            categories.map(category => (
              <li>
                <a
                  href={`#${category.replace(/\s+/g, "-").toLowerCase()}`}
                  data-tool-category-link
                  class="border-accent bg-accent text-accent-foreground focus-visible:outline-focus rounded-pill inline-flex min-h-11 touch-manipulation items-center border px-4 text-sm font-normal whitespace-nowrap transition duration-200 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
                >
                  {category}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div id="tools">
      <p
        id="tools-search-empty"
        class="text-muted-foreground max-w-content mx-auto hidden px-4 py-8 text-center"
        aria-live="polite"
      >
        No tools match this search.
      </p>
      {
        Object.entries(grouped).map(([category, items], index) => (
          <Section
            id={category.replace(/\s+/g, "-").toLowerCase()}
            width="wide"
            spacing="sm"
            tone={index % 2 === 1 ? "surface" : "default"}
            class="tablet:scroll-mt-36 tablet:py-12 desktop:py-16 scroll-mt-32 py-8"
          >
            <div class="flex flex-wrap items-end justify-between gap-4">
              <Heading
                level={2}
                weight="normal"
                class="tablet:text-4xl text-3xl"
              >
                {category}
              </Heading>
              <p class="text-muted-foreground text-sm">
                {items.length} {items.length === 1 ? "tool" : "tools"}
              </p>
            </div>
            <div class="tablet:grid-cols-2 desktop:grid-cols-3 tablet:mt-8 tablet:gap-6 mt-5 grid grid-cols-2 gap-3">
              {items.map(product => (
                <div
                  data-tool-card
                  data-tool-search={`${product.name} ${product.description} ${product.category}`.toLowerCase()}
                >
                  <ProductCard {product} />
                </div>
              ))}
            </div>
          </Section>
        ))
      }
    </div>

    <Section width="wide" spacing="sm" class="tablet:py-12 desktop:py-16 py-8">
      <aside
        class="border-border bg-surface tablet:p-8 mx-auto max-w-4xl rounded-md border p-5"
      >
        <h2
          class="font-display text-foreground text-2xl leading-snug font-normal"
        >
          Affiliate Disclosure
        </h2>
        <p class="text-muted-foreground mt-3 leading-7">
          Some links on this page are affiliate links. If you purchase through
          them, we may earn a small commission at no extra cost to you. It helps
          support Calcutta Kitchen and allows us to continue creating free
          recipes. We only recommend products that we personally use or
          genuinely believe offer excellent value.
        </p>
      </aside>
    </Section>
  </main>

  <Footer
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    groups={siteConfig.footerNavigation}
    socialLinks={siteConfig.socialLinks}
  />
</BaseLayout>

<script>
  const searchForm =
    document.querySelector<HTMLFormElement>("#tools-search-form");
  const searchInput = document.querySelector<HTMLInputElement>("#tools-search");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-tool-card]")
  );
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>("#tools > section")
  );
  const categoryLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-tool-category-link]")
  );
  const emptyState = document.querySelector<HTMLElement>("#tools-search-empty");

  const filterTools = (value: string) => {
    const query = value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach(card => {
      const matches = !query || card.dataset.toolSearch?.includes(query);
      card.classList.toggle("hidden", !matches);
      if (matches) visibleCount += 1;
    });

    sections.forEach(section => {
      section.classList.toggle(
        "hidden",
        !section.querySelector("[data-tool-card]:not(.hidden)")
      );
    });

    emptyState?.classList.toggle("hidden", visibleCount > 0);
  };

  searchInput?.addEventListener("input", () => filterTools(searchInput.value));
  searchForm?.addEventListener("submit", event => {
    event.preventDefault();
    filterTools(searchInput?.value ?? "");
    document.querySelector("#tools")?.scrollIntoView({ behavior: "smooth" });
  });

  categoryLinks.forEach(link => {
    link.addEventListener("click", () => {
      categoryLinks.forEach(categoryLink => {
        categoryLink.classList.remove("bg-background", "text-foreground");
        categoryLink.classList.add("bg-accent", "text-accent-foreground");
      });
      link.classList.remove("bg-accent", "text-accent-foreground");
      link.classList.add("bg-background", "text-foreground");
    });
  });
</script>
