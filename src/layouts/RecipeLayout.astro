---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import Section from "@/components/common/Section.astro";
import EquipmentList from "@/components/recipe/EquipmentList.astro";
import FAQSection from "@/components/recipe/FAQSection.astro";
import IngredientList from "@/components/recipe/IngredientList.astro";
import RecipeFacts from "@/components/recipe/RecipeFacts.astro";
import RecipeHero from "@/components/recipe/RecipeHero.astro";
import RecipeActions from "@/components/recipe/RecipeActions.astro";
import RelatedRecipes from "@/components/recipe/RelatedRecipes.astro";
import StepList from "@/components/recipe/StepList.astro";
import TipsCard from "@/components/recipe/TipsCard.astro";
import VideoSection from "@/components/recipe/VideoSection.astro";
import Footer from "@/components/navigation/Footer.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { products as productEntries } from "@/data/products";
import type { ImageMetadata } from "astro";
import type { RecipeLayoutData } from "@/types/recipe";
import { getTotalRecipeTime, getYouTubeThumbnailUrl } from "@/utils/recipe";
import {
  createBreadcrumbJsonLd,
  createFaqJsonLd,
  createRecipeJsonLd,
  serializeJsonLd,
} from "@/utils/seo";

type Props = {
  recipe: RecipeLayoutData;
  slug: string;
  products: (typeof productEntries)[number][];
  relatedRecipes: {
    href: string;
    title: string;
    description: string;
    image: ImageMetadata;
    imageAlt: string;
    eyebrow: string;
    metadata: string[];
  }[];
};

const { recipe, slug, products, relatedRecipes } = Astro.props;
const canonicalPath = `/recipes/${slug}/`;
const canonicalUrl = new URL(canonicalPath, siteConfig.url).href;
const imageUrl = new URL(recipe.coverImage.src, siteConfig.url).href;
const totalTime = getTotalRecipeTime(recipe);
const videoThumbnail =
  recipe.video &&
  (recipe.video.thumbnail ?? getYouTubeThumbnailUrl(recipe.video.url));
const metadata = {
  title: recipe.seoTitle ?? recipe.title,
  description: recipe.seoDescription ?? recipe.description,
  canonicalPath,
  image: imageUrl,
};
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Recipes", href: "/recipes" },
  { label: recipe.title },
];
const recipeJsonLd = createRecipeJsonLd({
  title: recipe.title,
  description: recipe.description,
  canonicalUrl,
  imageUrl,
  publishDate: recipe.publishDate,
  updatedDate: recipe.updatedDate,
  prepTime: recipe.prepTime,
  cookTime: recipe.cookTime,
  totalTime,
  servings: recipe.servings,
  ingredients: recipe.ingredients.map(ingredient =>
    [ingredient.quantity, ingredient.unit, ingredient.name]
      .filter(Boolean)
      .join(" ")
  ),
  steps: recipe.steps.map(step => step.instruction),
  author: "Calcutta Kitchen",
});
const faqJsonLd = createFaqJsonLd(recipe.faq);
const breadcrumbJsonLd = createBreadcrumbJsonLd([
  { name: "Home", url: new URL("/", siteConfig.url).href },
  { name: "Recipes", url: new URL("/recipes", siteConfig.url).href },
  { name: recipe.title, url: canonicalUrl },
]);
---

<BaseLayout {metadata}>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(recipeJsonLd)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(breadcrumbJsonLd)}
    />
    {
      faqJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeJsonLd(faqJsonLd)}
        />
      )
    }
  </Fragment>
  <Navbar
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    items={siteConfig.navigation}
    socialLinks={siteConfig.socialLinks}
  />
  <main id="main-content">
    <Section width="wide" spacing="sm" class="pb-0">
      <Breadcrumbs items={breadcrumbItems} />
    </Section>
    <Section
      width="wide"
      spacing="md"
      class="tablet:pt-12 tablet:pb-8 pt-6 pb-6"
    >
      <RecipeHero
        title={recipe.title}
        titleBn={recipe.titleBn}
        description={recipe.description}
        image={recipe.coverImage}
        imageAlt={recipe.coverImageAlt}
      />
      <RecipeFacts
        class="mt-10"
        prepTime={recipe.prepTime}
        cookTime={recipe.cookTime}
        {totalTime}
        servings={recipe.servings}
        difficulty={recipe.difficulty}
      />
      <section aria-labelledby="overview-heading" class="mt-12 max-w-prose">
        <h2
          id="overview-heading"
          class="font-display text-foreground text-4xl font-normal tracking-tight"
        >
          About this recipe
        </h2>
        <div class="text-muted-foreground mt-5 space-y-4 leading-relaxed">
          {recipe.about.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </section>
    </Section>
    <Section width="content" spacing="md" class="tablet:pt-6 pt-4">
      {products.length > 0 && <EquipmentList {products} data-print-exclude />}
      <RecipeActions
        titleBn={recipe.titleBn}
        slug={slug}
        recipe={{
          title: recipe.title,
          titleBn: recipe.titleBn,
          description: recipe.description,
          about: recipe.about,
          ingredients: recipe.ingredients,
          ingredientsBn: recipe.ingredientsBn,
          steps: recipe.steps.map(({ group, instruction }) => ({
            group,
            instruction,
          })),
          stepsBn: recipe.stepsBn,
          tips: recipe.tips,
          prepTime: recipe.prepTime,
          cookTime: recipe.cookTime,
          additionalTime: recipe.additionalTime,
          servings: recipe.servings,
          difficulty: recipe.difficulty,
        }}
        hasBengaliContent={Boolean(
          recipe.titleBn ||
          recipe.ingredientsBn.length > 0 ||
          recipe.stepsBn.length > 0
        )}
        hasVideo={Boolean(recipe.video && videoThumbnail)}
      />
      <IngredientList
        ingredients={recipe.ingredients}
        ingredientsBn={recipe.ingredientsBn}
        class="mt-10"
      />
      <StepList steps={recipe.steps} stepsBn={recipe.stepsBn} class="mt-10" />
      {recipe.tips.length > 0 && <TipsCard tips={recipe.tips} class="mt-10" />}
      {recipe.faq.length > 0 && <FAQSection items={recipe.faq} class="mt-10" />}
      {
        recipe.video && videoThumbnail && (
          <VideoSection
            class="mt-10"
            url={recipe.video.url}
            title={recipe.video.title ?? recipe.title}
            description={recipe.video.description}
            thumbnail={videoThumbnail}
          />
        )
      }
      {
        relatedRecipes.length > 0 && (
          <RelatedRecipes recipes={relatedRecipes} class="mt-10" />
        )
      }
    </Section>
  </main>
  <Footer
    brand={{ label: siteConfig.name, href: "/" }}
    logo={siteConfig.logo}
    groups={siteConfig.footerNavigation}
    socialLinks={siteConfig.socialLinks}
  />
</BaseLayout>
