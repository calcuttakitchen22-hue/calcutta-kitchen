---
import BaseLayout from "./BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import type { PageMetadata, SiteConfiguration } from "@/types/site";

type Props = {
  metadata?: PageMetadata;
  site?: SiteConfiguration;
  width?: "content" | "wide";
  class?: string;
};

const { metadata, site, width = "content", class: className } = Astro.props;
---

<BaseLayout {metadata} {site}>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <slot name="header" />
  <main id="main-content" class={className}>
    <Container size={width}>
      <slot />
    </Container>
  </main>
  <slot name="footer" />
</BaseLayout>
