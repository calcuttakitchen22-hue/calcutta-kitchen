---
import type { NavigationItem } from "@/types/site";
import SearchInput from "@/components/common/SearchInput.astro";
import SocialIcon from "@/components/common/SocialIcon.astro";
import type { SocialLink } from "@/types/site";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  items: NavigationItem[];
  socialLinks?: SocialLink[];
  searchHref?: string;
  class?: string;
};

const {
  items,
  socialLinks = [],
  searchHref = "/search",
  class: className,
} = Astro.props;
---

<div
  id="mobile-navigation"
  class:list={["desktop:hidden fixed inset-0 z-50 hidden", className]}
  aria-hidden="true"
>
  <button
    type="button"
    data-mobile-navigation-backdrop
    aria-label="Close menu"
    class="bg-foreground/45 fixed inset-0"></button>
  <aside
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    class="bg-background shadow-card fixed inset-y-0 right-0 flex w-full max-w-sm flex-col overflow-y-auto p-4"
  >
    <div class="flex items-center justify-end">
      <button
        type="button"
        data-mobile-navigation-close
        class="rounded-pill text-foreground hover:bg-surface focus-visible:outline-focus grid size-11 place-items-center transition focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <span class="sr-only">Close menu</span>
        <span aria-hidden="true" class="text-2xl">×</span>
      </button>
    </div>
    <nav class="max-w-content mx-auto w-full">
      <form action={searchHref} method="get">
        <SearchInput id="mobile-navigation-search" />
      </form>
      <ul class="mt-5">
        {
          items.map(item => (
            <li>
              <a
                href={item.href}
                class="text-foreground hover:bg-surface hover:text-accent focus-visible:outline-focus block min-h-11 rounded-sm px-3 py-2 font-normal transition focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="border-border mt-2 border-t pt-2">
          <ThemeToggle class="w-full justify-start px-3" />
        </li>
      </ul>
      {
        socialLinks.length > 0 && (
          <ul class="border-border mt-5 flex gap-2 border-t pt-4">
            {socialLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.label}
                  class="rounded-pill text-foreground hover:bg-surface hover:text-accent focus-visible:outline-focus grid size-11 place-items-center transition focus-visible:outline-2 focus-visible:outline-offset-2"
                >
                  <SocialIcon platform={link.platform} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </nav>
  </aside>
</div>

<script>
  const drawer = document.querySelector<HTMLElement>("#mobile-navigation");
  const trigger = document.querySelector<HTMLButtonElement>(
    "[data-mobile-navigation-trigger]"
  );
  const closeButton = drawer?.querySelector<HTMLButtonElement>(
    "[data-mobile-navigation-close]"
  );
  const backdrop = drawer?.querySelector<HTMLButtonElement>(
    "[data-mobile-navigation-backdrop]"
  );
  let previousOverflow = "";

  const closeDrawer = () => {
    if (!drawer || !trigger) return;
    drawer.classList.add("hidden");
    drawer.setAttribute("aria-hidden", "true");
    trigger.setAttribute("aria-expanded", "false");
    document.body.style.overflow = previousOverflow;
    trigger.focus();
  };

  const openDrawer = () => {
    if (!drawer || !trigger) return;
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    drawer.classList.remove("hidden");
    drawer.setAttribute("aria-hidden", "false");
    trigger.setAttribute("aria-expanded", "true");
    closeButton?.focus();
  };

  trigger?.addEventListener("click", openDrawer);
  closeButton?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", event => {
    if (
      event.key === "Escape" &&
      drawer &&
      !drawer.classList.contains("hidden")
    )
      closeDrawer();
  });
</script>
