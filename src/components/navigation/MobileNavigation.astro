---
import type { NavigationItem } from "@/types/site";

type Props = {
  brand: NavigationItem;
  items: NavigationItem[];
  searchHref?: string;
  class?: string;
};

const { brand, items, searchHref = "/search", class: className } = Astro.props;
---

<details class:list={["group desktop:hidden", className]}>
  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-pill border border-border bg-surface px-4 font-semibold text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
    <span>{brand.label}</span>
    <span aria-hidden="true" class="transition group-open:rotate-45">+</span>
  </summary>
  <nav aria-label="Mobile navigation" class="mt-3 rounded-md border border-border bg-background p-2 shadow-card">
    <ul>
      {items.map(item => (
        <li>
          <a href={item.href} class="block min-h-11 rounded-sm px-3 py-2 font-semibold text-foreground transition hover:bg-surface hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
            {item.label}
          </a>
        </li>
      ))}
      <li class="border-t border-border pt-2">
        <a href={searchHref} class="block min-h-11 rounded-sm px-3 py-2 font-semibold text-foreground transition hover:bg-surface hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
          Search
        </a>
      </li>
    </ul>
  </nav>
</details>
