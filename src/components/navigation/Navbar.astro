---
import Container from "@/components/common/Container.astro";
import MobileNavigation from "./MobileNavigation.astro";
import MobileNavigationTrigger from "./MobileNavigationTrigger.astro";
import ThemeToggle from "./ThemeToggle.astro";
import type { NavigationItem, SiteLogo, SocialLink } from "@/types/site";

type Props = {
  brand: NavigationItem;
  logo?: SiteLogo;
  items: NavigationItem[];
  socialLinks?: SocialLink[];
  searchHref?: string;
  class?: string;
};

const {
  brand,
  logo,
  items,
  socialLinks = [],
  searchHref = "/search",
  class: className,
} = Astro.props;
---

<header
  class:list={[
    "border-border bg-background/95 sticky top-0 z-40 border-b backdrop-blur",
    className,
  ]}
>
  <Container size="wide">
    <div class="flex min-h-[72px] items-center justify-between gap-6">
      <a
        href={brand.href}
        aria-label={brand.label}
        class="font-display text-foreground focus-visible:outline-focus flex max-w-[148px] items-center text-2xl font-semibold focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        {
          logo ? (
            <img
              src={logo.src.src}
              alt={logo.alt}
              width={logo.width}
              height={logo.height}
              class="h-10 w-auto object-contain"
            />
          ) : (
            brand.label
          )
        }
      </a>
      <nav aria-label="Primary navigation" class="desktop:block hidden">
        <ul class="flex items-center gap-6">
          {
            items.map(item => (
              <li>
                <a
                  href={item.href}
                  class="text-foreground hover:text-accent focus-visible:outline-focus text-sm font-normal transition focus-visible:outline-2 focus-visible:outline-offset-4"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="flex items-center gap-1">
        <ThemeToggle class="desktop:grid hidden" />
        <MobileNavigationTrigger />
      </div>
    </div>
  </Container>
</header>
<MobileNavigation {items} {socialLinks} {searchHref} />
