---
import Container from "@/components/common/Container.astro";
import type { NavigationItem } from "@/types/site";

type Props = {
  brand: NavigationItem;
  items: NavigationItem[];
  searchHref?: string;
  class?: string;
};

const { brand, items, searchHref = "/search", class: className } = Astro.props;
---

<header class:list={["sticky top-0 z-40 border-b border-border bg-background/95 backdrop-blur", className]}>
  <Container size="wide">
    <div class="flex min-h-[72px] items-center justify-between gap-6">
      <a href={brand.href} class="font-display text-2xl font-semibold text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus">
        {brand.label}
      </a>
      <nav aria-label="Primary navigation" class="hidden desktop:block">
        <ul class="flex items-center gap-6">
          {items.map(item => (
            <li>
              <a href={item.href} class="text-sm font-semibold text-foreground transition hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href={searchHref} class="grid size-11 place-items-center rounded-pill text-foreground transition hover:bg-surface hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
        <span aria-hidden="true">⌕</span>
        <span class="sr-only">Search</span>
      </a>
    </div>
  </Container>
</header>
