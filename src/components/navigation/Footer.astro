---
import Container from "@/components/common/Container.astro";
import SocialIcon from "@/components/common/SocialIcon.astro";
import type { FooterNavigationGroup, NavigationItem, SiteLogo, SocialLink } from "@/types/site";

type Props = {
  brand: NavigationItem;
  logo?: SiteLogo;
  groups?: FooterNavigationGroup[];
  socialLinks?: SocialLink[];
  copyright?: string;
  class?: string;
};

const {
  brand, logo,
  groups = [],
  socialLinks = [],
  copyright = `© ${new Date().getFullYear()} ${brand.label}`,
  class: className,
} = Astro.props;
---

<footer class:list={["bg-foreground text-background", className]}>
  <Container size="wide">
    <div class="grid gap-10 py-12 tablet:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div>
        <a href={brand.href} aria-label={brand.label} class="flex max-w-[148px] items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus">
          {logo ? <img src={logo.src.src} alt={logo.alt} width={logo.width} height={logo.height} class="h-10 w-auto object-contain" /> : <span class="font-display text-3xl font-semibold">{brand.label}</span>}
        </a>
        {socialLinks.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {socialLinks.map(link => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} class="grid size-11 place-items-center rounded-pill text-background transition hover:bg-background/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus">
                  <SocialIcon platform={link.platform} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {groups.length > 0 && (
        <div class="grid gap-8 sm:grid-cols-2">
          {groups.map(group => (
            <section aria-label={group.label}>
              <h2 class="font-display text-lg font-semibold">{group.label}</h2>
              <ul class="mt-4 space-y-3">
                {group.items.map(item => (
                  <li>
                    <a href={item.href} class="text-sm underline decoration-transparent underline-offset-4 hover:decoration-current focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}
    </div>
    <div class="border-t border-background/25 py-5 text-sm text-background/80">{copyright}</div>
  </Container>
</footer>
