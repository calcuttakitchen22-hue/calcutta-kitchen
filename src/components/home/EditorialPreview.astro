---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  eyebrow: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  class?: string;
};

const {
  eyebrow,
  title,
  description,
  image,
  imageAlt,
  class: className,
} = Astro.props;
---

<article
  class:list={[
    "border-border bg-surface shadow-card grid overflow-hidden rounded-lg border",
    className,
  ]}
>
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 50vw, 100vw"
    loading="lazy"
    class="aspect-[4/3] size-full object-cover"
  />
  <div class="tablet:p-8 flex flex-col justify-center p-6">
    <p class="text-accent text-sm font-normal tracking-[0.12em] uppercase">
      {eyebrow}
    </p>
    <h3
      class="font-display text-foreground tablet:text-4xl mt-3 text-3xl font-medium tracking-tight"
    >
      {title}
    </h3>
    <p class="text-muted-foreground mt-4 leading-relaxed">{description}</p>
  </div>
</article>
