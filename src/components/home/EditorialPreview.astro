---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  eyebrow: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  class?: string;
};

const { eyebrow, title, description, image, imageAlt, class: className } = Astro.props;
---

<article class:list={["grid overflow-hidden rounded-lg border border-border bg-surface shadow-card", className]}>
  <Image src={image} alt={imageAlt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" loading="lazy" class="aspect-[4/3] size-full object-cover" />
  <div class="flex flex-col justify-center p-6 tablet:p-8">
    <p class="text-sm font-bold tracking-[0.12em] text-accent uppercase">{eyebrow}</p>
    <h3 class="mt-3 font-display text-3xl font-medium tracking-tight text-foreground tablet:text-4xl">{title}</h3>
    <p class="mt-4 leading-relaxed text-muted-foreground">{description}</p>
  </div>
</article>
