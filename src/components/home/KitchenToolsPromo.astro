---
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<section
  aria-labelledby="kitchen-tools-heading"
  class="border-border bg-background border-b py-5"
>
  <div
    class="max-w-wide tablet:px-6 desktop:px-8 tablet:flex-row tablet:items-center mx-auto flex w-full flex-col items-start justify-between gap-4 px-4"
  >
    <div class="tablet:w-auto w-full">
      <h2
        id="kitchen-tools-heading"
        class="font-display text-accent tablet:text-2xl mt-1 text-xl leading-relaxed font-medium"
      >
        Good রান্না begins with the right বাসন.
      </h2>
      <p
        class="text-foreground tablet:text-sm text-xs leading-relaxed font-semibold tracking-[0.12em] uppercase"
      >
        The right cookware won't make you a better cook overnight—but it might
        save you from blaming the recipe. These are the tools we trust in our
        kitchen, EVERY SINGLE DAY.
      </p>
    </div>
    <a
      href={href}
      class="rounded-pill bg-accent text-accent-foreground focus-visible:outline-focus tablet:mt-0 mt-6 inline-flex min-h-11 w-fit shrink-0 items-center px-4 text-sm font-semibold transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
      >See What We Use →</a
    >
  </div>
</section>
