---
type Video = {
  title: string;
  url: string;
  thumbnail: string;
};

type Props = {
  videos: Video[];
};

const { videos } = Astro.props;
---

<section aria-labelledby="videos-heading">
  <h2
    id="videos-heading"
    class="font-display text-foreground text-4xl font-semibold tracking-tight"
  >
    Latest YouTube videos
  </h2>
  <div class="tablet:grid-cols-2 desktop:grid-cols-3 mt-6 grid gap-6">
    {
      videos.map(video => (
        <article class="border-border bg-surface shadow-card overflow-hidden rounded-md border">
          <a
            href={video.url}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-visible:outline-focus block focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            <img
              src={video.thumbnail}
              alt={`Video preview: ${video.title}`}
              width="1280"
              height="720"
              loading="lazy"
              class="aspect-video w-full object-cover"
            />
            <h3 class="font-display text-foreground p-5 text-2xl font-semibold">
              {video.title}
            </h3>
          </a>
        </article>
      ))
    }
  </div>
</section>
