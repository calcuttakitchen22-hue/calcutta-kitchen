---
type Category = {
  title: string;
  description: string;
};

type Props = {
  categories: Category[];
};

const { categories } = Astro.props;
---

<section aria-labelledby="browse-categories-heading">
  <h2 id="browse-categories-heading" class="font-display text-4xl font-semibold tracking-tight text-foreground">Browse recipes</h2>
  <div class="mt-6 grid gap-4 tablet:grid-cols-2 desktop:grid-cols-4">
    {categories.map(category => (
      <article class="rounded-md border border-border bg-surface p-5">
        <h3 class="font-display text-2xl font-semibold text-foreground">{category.title}</h3>
        <p class="mt-2 leading-relaxed text-muted-foreground">{category.description}</p>
      </article>
    ))}
  </div>
</section>
