---
type Category = {
  title: string;
  description: string;
};

type Props = {
  heading: string;
  headingLanguage?: "bn";
  categories: Category[];
};

const { heading, headingLanguage, categories } = Astro.props;
---

<section aria-labelledby="browse-categories-heading">
  <h2
    id="browse-categories-heading"
    lang={headingLanguage}
    class="font-display text-foreground tablet:text-4xl text-3xl font-semibold tracking-tight"
  >
    {heading}
  </h2>
  <div
    class="tablet:mx-0 tablet:grid tablet:overflow-visible tablet:px-0 tablet:pb-0 tablet:grid-cols-2 desktop:grid-cols-4 -mx-4 mt-6 flex snap-x snap-mandatory [scrollbar-width:none] gap-4 overflow-x-auto px-4 pb-2 [&::-webkit-scrollbar]:hidden"
  >
    {
      categories.map(category => (
        <article class="border-border bg-surface tablet:w-auto w-[78vw] shrink-0 snap-start rounded-md border p-5">
          <h3 class="font-display text-foreground text-2xl font-medium">
            {category.title}
          </h3>
          <p class="text-muted-foreground mt-2 leading-relaxed">
            {category.description}
          </p>
        </article>
      ))
    }
  </div>
</section>
