---
import { Icon } from "astro-icon/components";

type DiscoveryItem = {
  label: string;
  href: string;
  icon: string;
  language?: "bn";
};

type Props = {
  items: DiscoveryItem[];
};

const { items } = Astro.props;
---

<nav
  aria-label="Recipe discovery"
  class="border-border bg-surface border-b py-3"
>
  <ul
    class="max-w-wide tablet:flex-wrap tablet:overflow-visible tablet:px-6 tablet:scroll-px-6 desktop:px-8 desktop:scroll-px-8 mx-auto flex w-full snap-x snap-mandatory scroll-px-4 [scrollbar-width:none] gap-3 overflow-x-auto px-4 [&::-webkit-scrollbar]:hidden"
  >
    {
      items.map(item => (
        <li class="shrink-0 snap-start">
          <a
            href={item.href}
            lang={item.language}
            class="rounded-pill border-border bg-background text-foreground hover:border-accent hover:text-accent focus-visible:outline-focus inline-flex min-h-11 items-center gap-2 border px-4 text-sm font-normal transition focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <Icon name={item.icon} aria-hidden="true" class="size-4 shrink-0" />
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
