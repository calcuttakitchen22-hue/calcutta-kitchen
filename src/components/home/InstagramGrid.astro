---
type InstagramPost = {
  title: string;
  url: string;
  thumbnail: string;
};

type Props = {
  posts: InstagramPost[];
};

const { posts } = Astro.props;
---

<section aria-labelledby="instagram-heading">
  <h2
    id="instagram-heading"
    class="font-display text-foreground tablet:text-4xl text-3xl font-semibold tracking-tight"
  >
    Watch on Instagram
  </h2>
  <div class="tablet:grid-cols-2 desktop:grid-cols-3 mt-6 grid gap-6">
    {
      posts.map(post => (
        <article class="border-border bg-surface shadow-card overflow-hidden rounded-md border">
          <a
            href={post.url}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-visible:outline-focus block focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            <img
              src={post.thumbnail}
              alt={`Instagram preview: ${post.title}`}
              width="1080"
              height="1080"
              loading="lazy"
              class="aspect-square w-full object-cover"
            />
            <h3 class="font-display text-foreground p-5 text-2xl font-semibold">
              {post.title}
            </h3>
          </a>
        </article>
      ))
    }
  </div>
</section>
