---
type Props = {
  size?: "content" | "wide" | "full";
  class?: string;
};

const { size = "content", class: className } = Astro.props;

const sizeClasses = {
  content: "max-w-content",
  wide: "max-w-wide",
  full: "max-w-none",
};
---

<div
  class:list={[
    "tablet:px-6 desktop:px-8 mx-auto w-full px-4",
    sizeClasses[size],
    className,
  ]}
>
  <slot />
</div>
