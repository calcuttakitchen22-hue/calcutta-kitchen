---
import type { HTMLAttributes } from "astro/types";

type Props = {
  href?: string;
  variant?: "primary" | "secondary" | "text";
  size?: "sm" | "md" | "lg";
  class?: string;
} & HTMLAttributes<"a"> & HTMLAttributes<"button">;

const {
  href,
  variant = "primary",
  size = "md",
  class: className,
  ...attrs
} = Astro.props;

const variantClasses = {
  primary:
    "bg-accent text-accent-foreground shadow-card hover:-translate-y-0.5 hover:opacity-90",
  secondary:
    "border border-foreground bg-background text-foreground hover:border-accent hover:text-accent",
  text: "text-foreground underline decoration-transparent underline-offset-4 hover:text-accent hover:decoration-current",
};

const sizeClasses = {
  sm: "min-h-11 px-4 text-sm",
  md: "min-h-11 px-5 text-base",
  lg: "min-h-12 px-6 text-lg",
};

const classes = [
  "inline-flex items-center justify-center gap-2 rounded-pill font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus",
  variantClasses[variant],
  sizeClasses[size],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...attrs}>
      <slot />
    </button>
  )
}
