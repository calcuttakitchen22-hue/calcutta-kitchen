---
type Props = {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  eyebrow?: string;
  align?: "start" | "center";
  weight?: "normal" | "medium" | "semibold";
  id?: string;
  class?: string;
};

const {
  level = 2,
  eyebrow,
  align = "start",
  weight = "semibold",
  id,
  class: className,
} = Astro.props;

const Tag = `h${level}` as "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
const levelClasses = {
  1: "text-5xl leading-[1.08] tablet:text-6xl",
  2: "text-4xl leading-tight tablet:text-5xl",
  3: "text-2xl leading-snug tablet:text-3xl",
  4: "text-xl leading-snug",
  5: "text-lg leading-snug",
  6: "text-base leading-snug",
};

const weightClasses = {
  normal: "font-normal",
  medium: "font-medium",
  semibold: "font-semibold",
};
---

<div class:list={[align === "center" && "text-center"]}>
  {eyebrow && <p class="mb-2 text-sm font-bold tracking-[0.12em] text-accent uppercase">{eyebrow}</p>}
  <Tag id={id} class:list={["font-display tracking-tight text-foreground", weightClasses[weight], levelClasses[level], className]}>
    <slot />
  </Tag>
</div>
