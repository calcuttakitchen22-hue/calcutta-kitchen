---
type Props = {
  tone?: "accent" | "neutral" | "outline";
  class?: string;
};

const { tone = "neutral", class: className } = Astro.props;
const toneClasses = {
  accent: "bg-accent text-accent-foreground",
  neutral: "bg-surface text-foreground",
  outline: "border border-border bg-transparent text-foreground",
};
---

<span class:list={["inline-flex items-center rounded-pill px-3 py-1 text-sm font-semibold", toneClasses[tone], className]}>
  <slot />
</span>
