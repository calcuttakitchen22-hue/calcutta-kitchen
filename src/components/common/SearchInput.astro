---
import type { HTMLAttributes } from "astro/types";

type Props = {
  id?: string;
  name?: string;
  label?: string;
  placeholder?: string;
  value?: string;
  class?: string;
} & HTMLAttributes<"input">;

const {
  id = "site-search",
  name = "q",
  label = "Search",
  placeholder = "Search recipes...",
  value,
  class: className,
  ...attrs
} = Astro.props;
---

<div class:list={["relative", className]}>
  <label class="sr-only" for={id}>{label}</label>
  <input
    id={id}
    name={name}
    type="search"
    value={value}
    placeholder={placeholder}
    class="rounded-pill border-border bg-surface text-foreground placeholder:text-muted-foreground focus-visible:border-accent focus-visible:outline-focus min-h-12 w-full border px-5 pr-12 text-base focus-visible:outline-2 focus-visible:outline-offset-2"
    {...attrs}
  />
  <span
    aria-hidden="true"
    class="text-muted-foreground pointer-events-none absolute inset-y-0 right-4 grid place-items-center"
    >⌕</span
  >
</div>
