---
import type { BreadcrumbItem } from "@/types/recipe";

type Props = {
  items: BreadcrumbItem[];
  class?: string;
};

const { items, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol
    class="text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
  >
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a
              href={item.href}
              class="focus-visible:outline-focus font-normal underline decoration-transparent underline-offset-4 hover:decoration-current focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              {item.label}
            </a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
