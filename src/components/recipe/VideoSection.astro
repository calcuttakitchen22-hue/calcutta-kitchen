---
type Props = {
  url: string;
  title: string;
  description?: string;
  thumbnail: string;
  class?: string;
};

const { url, title, description, thumbnail, class: className } = Astro.props;
---

<section id="video" aria-labelledby="video-heading" class={className}>
  <h2
    id="video-heading"
    class="font-display text-foreground text-4xl font-normal tracking-tight"
  >
    Watch the recipe
  </h2>
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="group border-border bg-surface focus-visible:outline-focus mt-6 block overflow-hidden rounded-lg border focus-visible:outline-2 focus-visible:outline-offset-4"
  >
    <div class="relative">
      <img
        src={thumbnail}
        alt={`Video preview: ${title}`}
        width="1280"
        height="720"
        loading="lazy"
        class="aspect-video w-full object-cover transition duration-200 group-hover:scale-[1.02]"
      />
      <span class="bg-foreground/20 absolute inset-0 grid place-items-center">
        <span
          class="rounded-pill bg-accent text-accent-foreground shadow-card px-5 py-3 text-sm font-normal"
          >Watch on YouTube</span
        >
      </span>
    </div>
    <div class="p-5">
      <h3 class="font-display text-foreground text-2xl font-normal">{title}</h3>
      {
        description && (
          <p class="text-muted-foreground mt-2 leading-relaxed">
            {description}
          </p>
        )
      }
    </div>
  </a>
</section>
