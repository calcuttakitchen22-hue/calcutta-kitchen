---
type Props = {
  prepTime: number;
  cookTime: number;
  totalTime: number;
  servings: string;
  difficulty: string;
  class?: string;
};

const { prepTime, cookTime, totalTime, servings, difficulty, class: className } = Astro.props;

const facts = [
  { label: "Prep time", value: `${prepTime} min` },
  { label: "Cook time", value: `${cookTime} min` },
  { label: "Total time", value: `${totalTime} min` },
  { label: "Servings", value: servings },
  { label: "Difficulty", value: difficulty },
];
---

<section aria-labelledby="recipe-facts-heading" class={className}>
  <h2 id="recipe-facts-heading" class="sr-only">Recipe information</h2>
  <dl class="grid grid-cols-3 gap-2 desktop:grid-cols-5">
    {facts.map(fact => (
      <div class="rounded-sm border border-border bg-surface px-3 py-2">
        <dt class="text-xs font-medium text-muted-foreground">{fact.label}</dt>
        <dd class="mt-0.5 font-display text-base font-medium capitalize text-foreground">{fact.value}</dd>
      </div>
    ))}
  </dl>
</section>
