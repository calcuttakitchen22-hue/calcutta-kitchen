---
type Props = {
  prepTime: number;
  cookTime: number;
  totalTime: number;
  servings: string;
  difficulty: string;
  class?: string;
};

const {
  prepTime,
  cookTime,
  totalTime,
  servings,
  difficulty,
  class: className,
} = Astro.props;

const facts = [
  { label: "Prep time", value: `${prepTime} min` },
  { label: "Cook time", value: `${cookTime} min` },
  { label: "Total time", value: `${totalTime} min` },
  { label: "Servings", value: servings },
  { label: "Difficulty", value: difficulty },
];
---

<section aria-labelledby="recipe-facts-heading" class={className}>
  <h2 id="recipe-facts-heading" class="sr-only">Recipe information</h2>
  <dl class="desktop:grid-cols-5 grid grid-cols-3 gap-2">
    {
      facts.map(fact => (
        <div class="border-border bg-surface rounded-md border px-4 py-3">
          <dt class="text-muted-foreground text-xs font-normal">
            {fact.label}
          </dt>
          <dd class="font-display text-foreground mt-0.5 text-base font-medium capitalize">
            {fact.value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
