---
import type { RecipeStep } from "@/types/recipe";

type Props = {
  steps: RecipeStep[];
  stepsBn?: string[];
  class?: string;
};

const { steps, stepsBn = [], class: className } = Astro.props;
---

<section id="method" aria-labelledby="method-heading" class={className}>
  <h2 id="method-heading" class="font-display text-4xl font-normal tracking-tight text-foreground">Cooking method</h2>
  <ol data-language-section="method" data-recipe-language="en" class="mt-6 space-y-5">
    {steps.map((step, index) => (
      <li class="rounded-md border border-border bg-surface p-5">
        <div class="flex gap-4">
          <span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-pill bg-accent font-bold text-accent-foreground">
            {index + 1}
          </span>
          <div>
            {step.title && <h3 class="font-display text-2xl font-semibold text-foreground">{step.title}</h3>}
            <p class:list={["leading-relaxed text-muted-foreground", step.title && "mt-2"]}>{step.instruction}</p>
            {step.image && step.imageAlt && <img src={step.image} alt={step.imageAlt} loading="lazy" class="mt-4 aspect-video w-full rounded-sm object-cover" />}
            {step.tip && <p class="mt-4 rounded-sm border-l-4 border-accent bg-background px-4 py-3 text-sm leading-relaxed text-foreground"><span class="font-bold">Tip: </span>{step.tip}</p>}
          </div>
        </div>
      </li>
    ))}
  </ol>
  {stepsBn.length > 0 && <ol data-language-section="method" data-recipe-language="bn" hidden lang="bn" class="mt-6 space-y-5">{stepsBn.filter(step => !step.startsWith("HEADING:")).map((step, index) => <li class="rounded-md border border-border bg-surface p-5"><div class="flex gap-4"><span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-pill bg-accent font-bold text-accent-foreground">{index + 1}</span><p class="leading-relaxed text-muted-foreground">{step}</p></div></li>)}</ol>}
</section>
