---
import ProductCardSmall from "@/components/ProductCardSmall.astro";
import type { products as productEntries } from "@/data/products";

type Props = {
  products: (typeof productEntries)[number][];
  class?: string;
};

const { products, class: className } = Astro.props;
---

<section id="equipment" aria-labelledby="equipment-heading" class={className} data-print-exclude>
  <h2 id="equipment-heading" class="font-display text-4xl font-normal tracking-tight text-foreground">Equipment</h2>
  <div class="mt-6 grid gap-4 tablet:grid-cols-2 desktop:grid-cols-3">
    {products.map(product => <ProductCardSmall {product} />)}
  </div>
</section>
