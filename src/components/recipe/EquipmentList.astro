---
import type { RecipeEquipment } from "@/types/recipe";

type Props = {
  equipment: RecipeEquipment[];
  class?: string;
};

const { equipment, class: className } = Astro.props;
---

<section id="equipment" aria-labelledby="equipment-heading" class={className}>
  <h2 id="equipment-heading" class="font-display text-4xl font-semibold tracking-tight text-foreground">Equipment</h2>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2">
    {equipment.map(item => (
      <li class="rounded-md border border-border bg-surface px-4 py-3 font-semibold text-foreground">{item.name}</li>
    ))}
  </ul>
</section>
