---
import ProductCardSmall from "@/components/ProductCardSmall.astro";
import type { products as productEntries } from "@/data/products";

type Props = {
  products: (typeof productEntries)[number][];
  class?: string;
};

const { products, class: className } = Astro.props;
---

<section
  id="equipment"
  aria-labelledby="equipment-heading"
  class={className}
  data-print-exclude
>
  <h2
    id="equipment-heading"
    class="font-display text-foreground text-4xl font-normal tracking-tight"
  >
    Equipment
  </h2>
  <div
    class="tablet:mx-0 tablet:grid tablet:overflow-visible tablet:px-0 tablet:pb-0 tablet:grid-cols-2 desktop:grid-cols-3 -mx-4 mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2"
  >
    {
      products.map(product => (
        <div class="tablet:w-auto w-[78vw] shrink-0 snap-start">
          <ProductCardSmall {product} />
        </div>
      ))
    }
  </div>
</section>
