---
import type { RecipeFaq } from "@/types/recipe";

type Props = {
  items: RecipeFaq[];
  class?: string;
};

const { items, class: className } = Astro.props;
---

<section id="faq" aria-labelledby="faq-heading" class={className}>
  <h2
    id="faq-heading"
    class="font-display text-foreground text-4xl font-normal tracking-tight"
  >
    Frequently asked questions
  </h2>
  <div
    class="divide-border border-border bg-surface mt-6 divide-y rounded-md border"
  >
    {
      items.map(item => (
        <details class="group px-5 py-4">
          <summary class="font-display text-foreground cursor-pointer list-none pr-8 text-xl font-normal marker:hidden">
            {item.question}
          </summary>
          <p class="text-muted-foreground mt-3 leading-relaxed">
            {item.answer}
          </p>
        </details>
      ))
    }
  </div>
</section>
