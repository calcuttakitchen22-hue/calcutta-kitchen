---
import type { RecipeFaq } from "@/types/recipe";

type Props = {
  items: RecipeFaq[];
  class?: string;
};

const { items, class: className } = Astro.props;
---

<section id="faq" aria-labelledby="faq-heading" class={className}>
  <h2 id="faq-heading" class="font-display text-4xl font-normal tracking-tight text-foreground">Frequently asked questions</h2>
  <div class="mt-6 divide-y divide-border rounded-md border border-border bg-surface">
    {items.map(item => (
      <details class="group px-5 py-4">
        <summary class="cursor-pointer list-none pr-8 font-display text-xl font-semibold text-foreground marker:hidden">
          {item.question}
        </summary>
        <p class="mt-3 leading-relaxed text-muted-foreground">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
