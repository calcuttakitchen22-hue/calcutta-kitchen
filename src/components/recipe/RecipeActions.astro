---
import type { RecipeIngredient, RecipeStep } from "@/types/recipe";

type Props = {
  title: string;
  titleBn?: string;
  about: string[];
  ingredients: RecipeIngredient[];
  ingredientsBn: string[];
  steps: RecipeStep[];
  stepsBn: string[];
  tips: string[];
  metadata: string[];
  hasVideo?: boolean;
};

const { title, titleBn, about, ingredients, ingredientsBn, steps, stepsBn, tips, metadata, hasVideo = false } = Astro.props;
const hasBengaliContent = Boolean(titleBn || ingredientsBn.length > 0 || stepsBn.length > 0);
---

<section aria-label="Recipe actions" class="mt-8 flex flex-wrap justify-center gap-2" data-print-exclude>
  <button type="button" data-download-recipe class="min-h-11 rounded-pill bg-accent px-4 text-sm font-semibold text-accent-foreground transition duration-200 hover:-translate-y-px hover:bg-accent/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">Download Recipe</button>
  {hasBengaliContent && <button type="button" data-language-toggle aria-pressed="false" class="min-h-11 rounded-pill border border-border px-4 text-base font-bold text-foreground transition duration-200 hover:-translate-y-px hover:border-accent hover:bg-accent/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">বাংলায় দেখুন</button>}
  {hasVideo && <button type="button" data-watch-video class="min-h-11 rounded-pill border border-border px-4 text-sm font-semibold text-foreground transition duration-200 hover:-translate-y-px hover:border-accent hover:bg-accent/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">Watch video</button>}
</section>

<article id="recipe-pdf" class="fixed top-0 -left-[10000px] w-[800px] bg-background p-8 text-foreground" aria-hidden="true">
  <h1 class="font-display text-4xl font-medium">{title}{titleBn && <span lang="bn"> ({titleBn})</span>}</h1>
  <p class="mt-3 text-muted-foreground">{metadata.join(" · ")}</p>
  <section class="mt-8"><h2 class="font-display text-2xl font-medium">About this recipe</h2>{about.map(paragraph => <p class="mt-3 leading-relaxed">{paragraph}</p>)}</section>
  <section class="mt-8"><h2 class="font-display text-2xl font-medium"><span data-pdf-language="en">Ingredients</span><span data-pdf-language="bn" hidden lang="bn">উপকরণ</span></h2><ul data-pdf-language="en" class="mt-3 list-disc pl-5">{ingredients.map(item => <li class:list={[item.group && "mt-4 list-none font-medium"]}>{item.group ?? [item.quantity, item.unit, item.name, item.notes].filter(Boolean).join(" ")}</li>)}</ul>{ingredientsBn.length > 0 && <ul data-pdf-language="bn" hidden lang="bn" class="mt-3 list-disc pl-5">{ingredientsBn.map(item => <li class:list={[item.startsWith("HEADING:") && "mt-4 list-none font-medium"]}>{item.replace(/^HEADING:/, "")}</li>)}</ul>}</section>
  <section class="mt-8"><h2 class="font-display text-2xl font-medium"><span data-pdf-language="en">Method</span><span data-pdf-language="bn" hidden lang="bn">রান্নার পদ্ধতি</span></h2><ol data-pdf-language="en" class="mt-3 list-decimal pl-5">{steps.map((step, index) => <li class:list={["mt-2", step.group && step.group !== steps[index - 1]?.group && "mt-4 font-medium"]}>{step.group && step.group !== steps[index - 1]?.group && `${step.group}: `}{step.instruction}</li>)}</ol>{stepsBn.length > 0 && <ol data-pdf-language="bn" hidden lang="bn" class="mt-3 list-decimal pl-5">{stepsBn.filter(step => !step.startsWith("HEADING:")).map(step => <li class="mt-2">{step}</li>)}</ol>}</section>
  <section class="mt-8"><h2 class="font-display text-2xl font-medium">Chef's tips</h2><ul class="mt-3 list-disc pl-5">{tips.map(tip => <li class="mt-2">{tip}</li>)}</ul></section>
</article>

<script>
  const actions = document.querySelector<HTMLElement>("[aria-label='Recipe actions']");
  const pdf = document.querySelector<HTMLElement>("#recipe-pdf");
  const languageKey = `calcutta-kitchen:${window.location.pathname}:language`;
  const toggle = actions?.querySelector<HTMLButtonElement>("[data-language-toggle]");
  const setLanguage = (language: "en" | "bn") => {
    document.documentElement.dataset.recipeLanguage = language;
    document.querySelectorAll<HTMLElement>("[data-language-section][data-recipe-language]").forEach(content => {
      content.hidden = content.dataset.recipeLanguage !== language;
    });
    pdf?.querySelectorAll<HTMLElement>("[data-pdf-language]").forEach(content => { content.hidden = content.dataset.pdfLanguage !== language; });
    if (toggle) {
      toggle.setAttribute("aria-pressed", String(language === "bn"));
      toggle.textContent = language === "bn" ? "View in English" : "বাংলায় দেখুন";
    }
    sessionStorage.setItem(languageKey, language);
    document.dispatchEvent(new CustomEvent("recipe-language-change", { detail: { language } }));
  };
  if (toggle) {
    setLanguage(sessionStorage.getItem(languageKey) === "bn" ? "bn" : "en");
    toggle.addEventListener("click", () => setLanguage(toggle.getAttribute("aria-pressed") === "true" ? "en" : "bn"));
  }
  actions?.querySelector<HTMLButtonElement>("[data-download-recipe]")?.addEventListener("click", async () => {
    if (!pdf) return;
    const { downloadRecipePdf } = await import("@/scripts/recipePdf");
    await downloadRecipePdf(pdf, document.title);
  });
  actions?.querySelector<HTMLButtonElement>("[data-watch-video]")?.addEventListener("click", () => {
    document.querySelector<HTMLElement>("#video")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>
