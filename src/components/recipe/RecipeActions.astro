---
type Props = {
  titleBn?: string;
  hasBengaliContent: boolean;
  hasVideo?: boolean;
  slug: string;
  recipe: import("@/scripts/structuredRecipePdf").StructuredRecipeInput;
};

const { hasBengaliContent, hasVideo = false, slug, recipe } = Astro.props;
---

<section
  aria-label="Recipe actions"
  class="mt-8 flex flex-wrap justify-center gap-2"
  data-print-exclude
  data-recipe-pdf-actions
>
  <span hidden data-recipe-pdf-data={JSON.stringify({ recipe, slug })}></span>
  <button
    type="button"
    data-download-recipe
    class="rounded-pill bg-accent text-accent-foreground hover:bg-accent/90 focus-visible:outline-focus min-h-11 px-4 text-sm font-normal transition duration-200 hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    Download Recipe
  </button>
  <p data-download-status class="sr-only" role="status" aria-live="polite"></p>
  {
    hasBengaliContent && (
      <button
        type="button"
        data-language-toggle
        aria-pressed="false"
        class="rounded-pill border-border text-foreground hover:border-accent hover:bg-accent/10 focus-visible:outline-focus min-h-11 border px-4 text-base font-normal transition duration-200 hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        বাংলায় দেখুন
      </button>
    )
  }
  {
    hasVideo && (
      <button
        type="button"
        data-watch-video
        class="rounded-pill bg-accent text-accent-foreground hover:bg-accent/90 focus-visible:outline-focus min-h-11 px-4 text-sm font-normal transition duration-200 hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Watch video
      </button>
    )
  }
</section>

<script>
  /* eslint-disable no-console */
  window.addEventListener("error", event => {
    console.error("Global PDF error:", event.error ?? event.message);
  });
  window.addEventListener("unhandledrejection", event => {
    console.error("Unhandled PDF rejection:", event.reason);
  });

  const actions = document.querySelector<HTMLElement>(
    "[aria-label='Recipe actions']"
  );
  const serializedData = actions?.querySelector<HTMLElement>(
    "[data-recipe-pdf-data]"
  )?.dataset.recipePdfData;
  const pdfData = serializedData ? JSON.parse(serializedData) : null;
  const languageKey = `calcutta-kitchen:${window.location.pathname}:language`;
  const toggle = actions?.querySelector<HTMLButtonElement>(
    "[data-language-toggle]"
  );
  const setLanguage = (language: "en" | "bn") => {
    document.documentElement.dataset.recipeLanguage = language;
    document
      .querySelectorAll<HTMLElement>(
        "[data-language-section][data-recipe-language]"
      )
      .forEach(content => {
        content.hidden = content.dataset.recipeLanguage !== language;
      });
    if (toggle) {
      toggle.setAttribute("aria-pressed", String(language === "bn"));
      toggle.textContent =
        language === "bn" ? "View in English" : "বাংলায় দেখুন";
    }
    sessionStorage.setItem(languageKey, language);
    document.dispatchEvent(
      new CustomEvent("recipe-language-change", { detail: { language } })
    );
  };
  if (toggle) {
    setLanguage(sessionStorage.getItem(languageKey) === "bn" ? "bn" : "en");
    toggle.addEventListener("click", () =>
      setLanguage(toggle.getAttribute("aria-pressed") === "true" ? "en" : "bn")
    );
  }
  actions
    ?.querySelector<HTMLButtonElement>("[data-download-recipe]")
    ?.addEventListener("click", async (event: Event) => {
      const language =
        document.documentElement.dataset.recipeLanguage === "bn" ? "bn" : "en";
      const button = event.currentTarget as HTMLButtonElement | null;
      if (!button) return;
      const status = actions?.querySelector<HTMLElement>(
        "[data-download-status]"
      );
      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      status?.classList.remove("sr-only");
      if (status) status.textContent = "Preparing your PDF…";
      try {
        if (!pdfData) throw new Error("Recipe PDF data is unavailable.");
        const recipeElement =
          document.querySelector<HTMLElement>("#recipe-pdf");
        if (recipeElement) {
          const computedStyle = getComputedStyle(recipeElement);
          console.log("[PDF] recipe element", recipeElement);
          console.log("[PDF] text length", recipeElement.innerText.length);
          console.log(
            "[PDF] Bengali characters",
            /[\u0980-\u09FF]/u.test(recipeElement.innerText)
          );
          console.log(
            "[PDF] dimensions",
            recipeElement.getBoundingClientRect()
          );
          console.log("[PDF] visibility", {
            display: computedStyle.display,
            visibility: computedStyle.visibility,
            opacity: computedStyle.opacity,
          });
        }
        const { downloadStructuredRecipePdf } =
          await import("@/scripts/structuredRecipePdf");
        await downloadStructuredRecipePdf(
          pdfData.recipe,
          pdfData.slug,
          language
        );
        if (status) status.textContent = "";
      } catch (error) {
        console.error("Recipe PDF generation failed:", error);
        if (error instanceof Error) {
          console.error("Message:", error.message);
          console.error("Stack:", error.stack);
        }
        if (status)
          status.textContent =
            error instanceof Error
              ? `PDF generation failed: ${error.message}`
              : "PDF generation failed due to an unknown error.";
      } finally {
        button.disabled = false;
        button.removeAttribute("aria-busy");
      }
    });
  actions
    ?.querySelector<HTMLButtonElement>("[data-watch-video]")
    ?.addEventListener("click", () => {
      document
        .querySelector<HTMLElement>("#video")
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
</script>
