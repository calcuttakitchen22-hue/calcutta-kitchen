---
import type { RecipeIngredient, RecipeStep } from "@/types/recipe";

type Props = {
  title: string;
  titleBn?: string;
  about: string[];
  ingredients: RecipeIngredient[];
  ingredientsBn: string[];
  steps: RecipeStep[];
  stepsBn: string[];
  tips: string[];
  metadata: string[];
};

const { title, titleBn, about, ingredients, ingredientsBn, steps, stepsBn, tips, metadata } = Astro.props;
const englishIngredients = ingredients.map(item => [item.quantity, item.unit, item.name, item.notes].filter(Boolean).join(" "));
const hasBengaliContent = Boolean(titleBn || ingredientsBn.length > 0 || stepsBn.length > 0);
---

<section aria-label="Recipe actions" class="mt-8 flex flex-wrap gap-2" data-print-exclude>
  <button type="button" data-download-recipe class="min-h-11 rounded-pill bg-accent px-4 text-sm font-semibold text-accent-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">Download Recipe</button>
  {hasBengaliContent && <button type="button" data-language-toggle aria-pressed="false" class="min-h-11 rounded-pill border border-border px-4 text-sm font-semibold text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">বাংলায় দেখুন</button>}
</section>

<article id="recipe-pdf" class="fixed top-0 -left-[10000px] w-[800px] bg-background p-8 text-foreground" aria-hidden="true">
  <p class="font-display text-lg font-medium text-foreground">Calcutta Kitchen</p>
  <p lang="bn" class="mt-1 text-sm text-muted-foreground">রেসিপি নয়, রান্না শেখাই</p>
  <h1 class="mt-6 font-display text-4xl font-medium">{title}{titleBn && <span lang="bn"> ({titleBn})</span>}</h1>
  <p class="mt-3 text-muted-foreground">{metadata.join(" · ")}</p>
  <section class="mt-8"><h2 class="font-display text-2xl font-medium">About this recipe</h2>{about.map(paragraph => <p class="mt-3 leading-relaxed">{paragraph}</p>)}</section>
  <section class="mt-8"><h2 class="font-display text-2xl font-medium">Ingredients</h2><ul data-pdf-language="en" class="mt-3 list-disc pl-5">{englishIngredients.map(item => <li>{item}</li>)}</ul>{ingredientsBn.length > 0 && <ul data-pdf-language="bn" hidden lang="bn" class="mt-3 list-disc pl-5">{ingredientsBn.map(item => <li>{item.replace(/^HEADING:/, "")}</li>)}</ul>}</section>
  <section class="mt-8"><h2 class="font-display text-2xl font-medium">Method</h2><ol data-pdf-language="en" class="mt-3 list-decimal pl-5">{steps.map(step => <li class="mt-2">{step.instruction}</li>)}</ol>{stepsBn.length > 0 && <ol data-pdf-language="bn" hidden lang="bn" class="mt-3 list-decimal pl-5">{stepsBn.filter(step => !step.startsWith("HEADING:")).map(step => <li class="mt-2">{step}</li>)}</ol>}</section>
  <section class="mt-8"><h2 class="font-display text-2xl font-medium">Chef's tips</h2><ul class="mt-3 list-disc pl-5">{tips.map(tip => <li class="mt-2">{tip}</li>)}</ul></section>
</article>

<script>
  const actions = document.querySelector<HTMLElement>("[aria-label='Recipe actions']");
  const pdf = document.querySelector<HTMLElement>("#recipe-pdf");
  const languageKey = `calcutta-kitchen:${window.location.pathname}:language`;
  const toggle = actions?.querySelector<HTMLButtonElement>("[data-language-toggle]");
  const setLanguage = (language: "en" | "bn") => {
    document.querySelectorAll<HTMLElement>("[data-language-section]").forEach(section => {
      const translations = section.querySelector<HTMLElement>("[data-recipe-language='bn']");
      if (!translations) return;
      section.querySelectorAll<HTMLElement>("[data-recipe-language]").forEach(content => { content.hidden = content.dataset.recipeLanguage !== language; });
    });
    pdf?.querySelectorAll<HTMLElement>("[data-pdf-language]").forEach(content => { content.hidden = content.dataset.pdfLanguage !== language; });
    if (toggle) {
      toggle.setAttribute("aria-pressed", String(language === "bn"));
      toggle.textContent = language === "bn" ? "View in English" : "বাংলায় দেখুন";
    }
    sessionStorage.setItem(languageKey, language);
  };
  if (toggle) {
    setLanguage(sessionStorage.getItem(languageKey) === "bn" ? "bn" : "en");
    toggle.addEventListener("click", () => setLanguage(toggle.getAttribute("aria-pressed") === "true" ? "en" : "bn"));
  }
  actions?.querySelector<HTMLButtonElement>("[data-download-recipe]")?.addEventListener("click", async () => {
    if (!pdf) return;
    const { downloadRecipePdf } = await import("@/scripts/recipePdf");
    await downloadRecipePdf(pdf, document.title);
  });
</script>
