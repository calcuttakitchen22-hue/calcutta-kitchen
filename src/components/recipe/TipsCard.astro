---
type Props = {
  tips: string[];
  class?: string;
};

const { tips, class: className } = Astro.props;
---

<section id="tips" aria-labelledby="tips-heading" class:list={["rounded-lg bg-foreground p-6 text-background tablet:p-8", className]}>
  <h2 id="tips-heading" class="font-display text-4xl font-semibold tracking-tight">Pro tips</h2>
  <ul class="mt-5 space-y-3 leading-relaxed text-background/90">
    {tips.map(tip => <li class="flex gap-3"><span aria-hidden="true" class="text-accent">•</span><span>{tip}</span></li>)}
  </ul>
</section>
