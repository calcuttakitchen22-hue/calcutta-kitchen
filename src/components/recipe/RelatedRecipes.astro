---
import RecipeCard from "@/components/cards/RecipeCard.astro";
import type { ImageMetadata } from "astro";

type Props = {
  recipes: {
    href: string;
    title: string;
    description: string;
    image: ImageMetadata;
    imageAlt: string;
    eyebrow: string;
    metadata: string[];
  }[];
  class?: string;
};

const { recipes, class: className } = Astro.props;
---

<section aria-labelledby="related-recipes-heading" class={className} data-print-exclude>
  <h2 id="related-recipes-heading" class="font-display text-4xl font-semibold tracking-tight text-foreground">Related recipes</h2>
  <div class="mt-6 grid gap-5 tablet:grid-cols-2 desktop:grid-cols-3">
    {recipes.map(recipe => <RecipeCard {...recipe} />)}
  </div>
</section>
