---
import RecipeCard from "@/components/cards/RecipeCard.astro";
import type { ImageMetadata } from "astro";

type Props = {
  recipes: {
    href: string;
    title: string;
    description: string;
    image: ImageMetadata;
    imageAlt: string;
    eyebrow: string;
    metadata: string[];
  }[];
  class?: string;
};

const { recipes, class: className } = Astro.props;
---

<section
  aria-labelledby="related-recipes-heading"
  class={className}
  data-print-exclude
>
  <h2
    id="related-recipes-heading"
    class="font-display text-foreground text-4xl font-normal tracking-tight"
  >
    Related recipes
  </h2>
  <div
    class="tablet:mx-0 tablet:grid tablet:overflow-visible tablet:px-0 tablet:pb-0 tablet:grid-cols-2 -mx-4 mt-6 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-2"
  >
    {
      recipes.map(recipe => (
        <div class="tablet:w-auto w-[82vw] shrink-0 snap-start">
          <RecipeCard {...recipe} />
        </div>
      ))
    }
  </div>
</section>
