---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  title: string;
  titleBn?: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  class?: string;
};

const {
  title,
  titleBn,
  description,
  image,
  imageAlt,
  class: className,
} = Astro.props;
---

<header
  class:list={[
    "desktop:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] desktop:items-center desktop:gap-8 grid gap-6",
    className,
  ]}
>
  <div class="min-w-0">
    <p class="text-accent text-sm font-normal tracking-[0.12em] uppercase">
      Recipe
    </p>
    <h1
      class="font-display text-foreground tablet:mt-3 tablet:text-6xl mt-2 text-5xl leading-[1.08] font-normal tracking-tight"
    >
      <span>{title}</span>{
        titleBn && (
          <span lang="bn" class="text-accent ml-2 font-bold">
            ({titleBn})
          </span>
        )
      }
    </h1>
    <p class="text-muted-foreground mt-5 max-w-prose text-lg leading-relaxed">
      {description}
    </p>
  </div>
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 50vw, 100vw"
    loading="eager"
    class="shadow-card aspect-[4/3] w-full rounded-lg object-cover"
  />
</header>
