---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  class?: string;
};

const { title, description, image, imageAlt, class: className } = Astro.props;
---

<header class:list={["grid gap-8 desktop:grid-cols-2 desktop:items-center", className]}>
  <div>
    <p class="text-sm font-bold tracking-[0.12em] text-accent uppercase">Recipe</p>
    <h1 class="mt-3 font-display text-5xl font-semibold leading-[1.08] tracking-tight text-foreground tablet:text-6xl">
      {title}
    </h1>
    <p class="mt-5 max-w-prose text-lg leading-relaxed text-muted-foreground">{description}</p>
  </div>
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 50vw, 100vw"
    loading="eager"
    class="aspect-[4/3] w-full rounded-lg object-cover shadow-card"
  />
</header>
