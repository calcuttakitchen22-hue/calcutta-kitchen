---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  title: string;
  titleBn?: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  class?: string;
};

const { title, titleBn, description, image, imageAlt, class: className } = Astro.props;
---

<header class:list={["grid gap-6 desktop:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] desktop:items-center desktop:gap-8", className]}>
  <div class="min-w-0">
    <p class="text-sm font-normal tracking-[0.12em] text-accent uppercase">Recipe</p>
    <h1 class="mt-2 font-display text-5xl font-normal leading-[1.08] tracking-tight text-foreground tablet:mt-3 tablet:text-6xl">
      <span>{title}</span>{titleBn && <span lang="bn" class="ml-2 font-bold">({titleBn})</span>}
    </h1>
    <p class="mt-5 max-w-prose text-lg leading-relaxed text-muted-foreground">{description}</p>
  </div>
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 50vw, 100vw"
    loading="eager"
    class="aspect-[4/3] w-full rounded-lg object-cover shadow-card"
  />
</header>
