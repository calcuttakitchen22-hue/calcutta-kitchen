---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Heading from "@/components/common/Heading.astro";

type Props = {
  href: string;
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  detail?: string;
  class?: string;
};

const {
  href,
  title,
  description,
  image,
  imageAlt,
  detail,
  class: className,
} = Astro.props;
---

<article
  class:list={[
    "border-border bg-surface shadow-card overflow-hidden rounded-md border transition duration-200 hover:-translate-y-1",
    className,
  ]}
>
  <a
    href={href}
    class="focus-visible:outline-focus block focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    {
      image && imageAlt && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[400, 640, 960]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          loading="lazy"
          class="aspect-[3/2] w-full object-cover"
        />
      )
    }
    <div class="p-5">
      <Heading level={3} weight="medium">{title}</Heading>
      {
        description && (
          <p class="text-muted-foreground mt-3 text-base leading-relaxed">
            {description}
          </p>
        )
      }
      {detail && <p class="text-accent mt-4 text-sm font-normal">{detail}</p>}
    </div>
  </a>
</article>
