---
import Button from "@/components/common/Button.astro";

const { product } = Astro.props;
---

<article
  class="border-border bg-background shadow-card flex h-full flex-col overflow-hidden rounded-md border"
>
  <div
    class="bg-surface tablet:p-6 flex aspect-square items-center justify-center p-2"
  >
    <img
      src={product.imageUrl}
      alt={product.name}
      width="640"
      height="480"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-contain"
    />
  </div>

  <div class="tablet:p-5 flex flex-1 flex-col p-3">
    <h3
      class="font-display text-foreground tablet:text-xl tablet:min-h-[3.5rem] line-clamp-2 min-h-[2.5rem] text-base leading-snug font-normal"
    >
      {product.name}
    </h3>
    <p
      class="text-muted-foreground tablet:text-sm tablet:leading-6 tablet:min-h-[4.5rem] mt-2 line-clamp-3 min-h-[3.75rem] text-xs leading-5"
    >
      {product.description}
    </p>
    <Button
      href={product.affiliateUrl}
      target="_blank"
      rel="noopener sponsored"
      class="tablet:mt-5 tablet:px-5 tablet:text-base tablet:whitespace-normal mt-4 w-full px-1 text-[0.6875rem] whitespace-nowrap"
    >
      View on Amazon
    </Button>
  </div>
</article>
