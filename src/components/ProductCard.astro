---
const { product } = Astro.props;
---

<div class="group flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">

  <div class="bg-gray-50 p-8">

  <img
      src={product.imageUrl}
      alt={product.name}
      class="mx-auto h-56 object-contain transition duration-300 group-hover:scale-105"
  />

  </div>

  <div class="flex flex-1 flex-col p-6">

    <h3 class="min-h-[3.5rem] text-xl font-semibold leading-7">
      {product.name}
    </h3>

    <p class="mt-3 min-h-[4.5rem] text-sm leading-6 text-gray-600">
      {product.description}
    </p>

    <div class="mt-5 border-t pt-5">

      <h4 class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
        Why we use it
      </p>

      <p
        class="mt-2 min-h-[3rem] text-sm leading-6 text-gray-600 line-clamp-2"
      >
        {product.whyWeUseIt}
      </p>

    </div>

    <a
        href={product.affiliateUrl}
        target="_blank"
        rel="noopener sponsored"
        class="mt-auto inline-flex w-full items-center justify-center rounded-xl bg-[#F24E07] px-5 py-3 font-medium text-white transition duration-300 hover:bg-[#d94506]"
    >

    🛒 View on Amazon

    </a>

  </div>

</div>