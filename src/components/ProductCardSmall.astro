---
const { product } = Astro.props;
---

<div class="group flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

  <a
    href={product.affiliateUrl}
    target="_blank"
    rel="noopener sponsored"
    class="block"
  >
    <div class="bg-gray-50 p-6">
      <img
        src={product.imageUrl}
        alt={product.name}
        class="mx-auto h-40 object-contain transition duration-300 group-hover:scale-105"
      />
    </div>
  </a>

  <div class="flex flex-1 flex-col p-5">

    <h3 class="min-h-[3rem] text-lg font-semibold leading-6">
      {product.name}
    </h3>

    <p class="mt-3 min-h-[3rem] text-sm leading-6 text-gray-600 line-clamp-2">
      {product.description}
    </p>

    <a
      href={product.affiliateUrl}
      target="_blank"
      rel="noopener sponsored"
      class="mt-auto inline-flex w-full items-center justify-center rounded-xl bg-[#F24E07] px-4 py-3 font-medium text-white transition duration-300 hover:bg-[#d94506]"
    >
      🛒 View on Amazon
    </a>

  </div>

</div>