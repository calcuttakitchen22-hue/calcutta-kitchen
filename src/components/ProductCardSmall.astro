---
import type { products as productEntries } from "@/data/products";

type Props = {
  product: (typeof productEntries)[number];
};

const { product } = Astro.props;
---

<article
  class="group border-border bg-surface shadow-card flex h-full flex-col overflow-hidden rounded-lg border transition duration-200 hover:-translate-y-1"
>
  <a
    href={product.affiliateUrl}
    target="_blank"
    rel="sponsored noopener noreferrer"
    class="block"
  >
    <div class="bg-background aspect-[4/3] p-6">
      <img
        src={product.imageUrl}
        alt={product.name}
        class="mx-auto size-full object-contain transition duration-300 group-hover:scale-105"
      />
    </div>
  </a>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-foreground min-h-[3rem] text-lg leading-6 font-normal">
      {product.name}
    </h3>

    <p class="text-muted-foreground mt-3 min-h-[3rem] text-sm leading-6">
      {product.description}
    </p>

    <a
      href={product.affiliateUrl}
      target="_blank"
      rel="sponsored noopener noreferrer"
      class="rounded-pill bg-accent text-accent-foreground focus-visible:outline-focus mt-auto inline-flex min-h-11 w-full items-center justify-center px-4 py-3 font-normal transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      🛒 View on Amazon
    </a>
  </div>
</article>
